import { GaugeArc } from "widgets.slint";
import { Ink, Locale } from "widgets.slint";
import { SlotRow } from "player-model.slint";
import { Kicker } from "game-controls.slint";

component Marks inherits HorizontalLayout {
    accessible-role: text;
    in property <[bool]> flags;
    in property <bool> stone;
    in property <length> diameter:12px;
    spacing: 4px;
    for held[i] in root.flags: Rectangle {
        width: root.diameter;
        height: root.diameter;
        private property <color> tone:[Ink.sage, Ink.russet, #5884aa, Ink.mustard, #9275a5, Ink.sand][i];
        background: !root.stone && held ? self.tone : transparent;
        border-width: held || root.stone ? 0px : 2px;
        border-color: Ink.muted;
        border-radius: root.diameter / 2;
        if root.stone: Path {
            width: 100%;
            height: 100%;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M5 1 L9 5 L5 9 L1 5 Z";
            fill: held ? parent.tone : transparent;
            stroke: held ? parent.tone : Ink.muted;
            stroke-width: 1px;
        }
    }
}

export component QuestStrip inherits HorizontalLayout {
    in property <SlotRow> slot;
    in property <bool> expanded;
    spacing: 8px;
    cross-axis-alignment: center;
    if root.slot.health != "": VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        if root.expanded: Kicker {
            text: Locale.t("HEARTS") + "  " + root.slot.health;
        }
        Text {
            text: root.slot.hearts;
            color: Ink.russet;
            font-size: root.expanded ? 21px : 15px;
            wrap: char-wrap;
            overflow: elide;
            accessible-label: root.slot.health + " " + Locale.t("hearts");
        }
    }
    if root.slot.medals.length > 0: VerticalLayout {
        alignment: center;
        spacing: 8px;
        if root.expanded: Kicker {
            text: Locale.t("MEDALLIONS") + "  \{root.slot.medals-have}/6";
        }
        Marks {
            flags: root.slot.medals;
            diameter: root.expanded ? 15px : 9px;
            accessible-label: "\{root.slot.medals-have}/6 " + Locale.t("medallions");
        }
    }
    if root.slot.stones.length > 0: VerticalLayout {
        alignment: center;
        spacing: 8px;
        if root.expanded: Kicker {
            text: Locale.t("STONES") + "  \{root.slot.stones-have}/3";
        }
        Marks {
            flags: root.slot.stones;
            stone: true;
            diameter: root.expanded ? 12px : 7px;
            accessible-label: "\{root.slot.stones-have}/3 " + Locale.t("stones");
        }
    }
}

component Arc inherits GaugeArc {
    in property <color> tone;
    width: 100%;
    height: 100%;
    center-y: 98;
    viewbox-height: 100;
    stroke: root.tone;
    stroke-width: 10px;
}

export component QuestChart inherits Rectangle {
    in property <SlotRow> slot;
    height: min(175px,root.width / 2);
    clip: true;
    for metric in [
        {
            r:92,
            known:root.slot.health != "",
            fraction:root.slot.health-fraction,
            tone:Ink.russet
        },
        {
            r:79,
            known:root.slot.medals.length > 0,
            fraction:root.slot.medals-have / 6.0,
            tone:Ink.mustard
        },
        {
            r:66,
            known:root.slot.stones.length > 0,
            fraction:root.slot.stones-have / 3.0,
            tone:Ink.sage
        }
    ]: Rectangle {
        visible: metric.known;

        Arc {
            radius: metric.r;
            fraction: 1;
            tone: Ink.raised;
        }

        if metric.fraction > 0: Arc {
            radius: metric.r;
            fraction: metric.fraction;
            tone: metric.tone;
        }
    }
}
