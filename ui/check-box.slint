import { Ink } from "widgets.slint";

export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    min-height: max(32px, content.min-height);
    preferred-height: max(32px, content.preferred-height);
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked <=> root.checked;
    accessible-action-default => { root.toggle(); }
    forward-focus: keys;

    content := HorizontalLayout {
        alignment: start;
        cross-axis-alignment: center;
        spacing: 10px;
        box := Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 5px;
            border-width: 2px;
            border-color: root.checked ? Ink.sage : pointer.has-hover ? Ink.sand : Ink.button-outline;
            background: root.checked ? Ink.sage : pointer.has-hover ? Ink.selected : Ink.well;
            if root.checked: Image {
                source: @image-url("icons/check.svg");
                width: 17px;
                height: 17px;
                colorize: Ink.black;
            }
            if Ink.focus-visible && keys.has-focus: Rectangle {
                x: -3px;
                y: -3px;
                width: box.width + 6px;
                height: box.height + 6px;
                border-radius: 8px;
                border-width: 2px;
                border-color: Ink.mustard;
            }
        }
        if root.text != "": Text {
            text: root.text;
            font-size: 15px;
            color: Ink.text;
            wrap: word-wrap;
            accessible-role: none;
        }
    }

    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.toggle();
                return accept;
            }
            reject
        }
        pointer := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            clicked => { Ink.focus-visible = false; keys.focus(); root.toggle(); }
        }
    }
}
