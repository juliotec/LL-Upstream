import { GaugeArc } from "widgets.slint";
import { CheckBox } from "check-box.slint";
import { ReleaseBody } from "game-notes.slint";
import { ScrollView } from "scroll-view.slint";
import { BuildReport, Game, GameStep } from "game-model.slint";
import { Ink, Locale } from "widgets.slint";
import {
    PosterTitle,
    PanelTitle,
    Label,
    Note,
    Kicker,
    Rule,
    SidePanel,
    GameAction,
} from "game-controls.slint";

component Arc inherits GaugeArc {
    in property <float> amount: 1;
    fraction: clamp(root.amount, 0.00001, 1);
    stroke-width: self.width * 0.036;
}

component StageRow inherits HorizontalLayout {
    in property <color> swatch;
    in property <string> marker;
    in property <string> title;
    in property <string> detail;
    spacing: 7px;
    cross-axis-alignment: start;
    Rectangle {
        width: 10px;
        height: 18px;
        Rectangle {
            y: 4px;
            height: 10px;
            background: root.swatch;
        }
    }
    Note { width: 14px; horizontal-alignment: center; text: root.marker; font-size: 14px; }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 2px;
        Note { text: root.title; font-size: 14px; }
        if root.detail != "": Note {
            text: root.detail;
            font-size: 12px;
            color: Ink.sand;
        }
    }
}

component BuildGauge inherits Rectangle {
    height: self.width * 0.51;
    private property <bool> done:Game.step == GameStep.ready;
    private property <[color]> colours:[Ink.sage, Ink.sand, Ink.mustard, Ink.russet, #735447];
    for index in [0, 1, 2, 3, 4]: Rectangle {
        visible: index != 4 || (Game.stage-fractions.length == 0 ? Game.shaders : Game.stage-fractions.length > 4);

        Arc {
            radius: 50 + index * 11;
            stroke: Ink.raised;
        }

        Arc {
            radius: 50 + index * 11;
            stroke: root.colours[index];
            amount: root.done ? 1 : Game.stage-fractions[index];
            visible: self.amount > 0;
        }
    }
    Text {
        y: parent.height * 0.65;
        height: parent.height * 0.35;
        text: root.done ? "100%" : Game.finalizing ? "…" : Game.overall >= 0 ? round(Game.overall * 100) + "%" : "…";
        color: Ink.text;
        font-family: "Inter";
        font-weight: 900;
        font-size: min(45px,parent.width * 0.13);
        horizontal-alignment: center;
        vertical-alignment: bottom;
    }
}

export component BuildProgress inherits Rectangle {
    private property <bool> done: Game.step == GameStep.ready;
    private property <bool> problem: Game.step == GameStep.problem;
    private property <string> notes:Game.notes-for(Game.pending-tag, Game.catalog-generation);

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        spacing: 0px;

        Rectangle {
            width: root.width - Ink.detail-width(root.width);
            background: Ink.page;

            VerticalLayout {
                padding: root.width < 960px ? 24px : 52px;
                padding-top: root.height < 530px ? 18px : 36px;
                padding-bottom: root.problem ? 24px : 0px;
                spacing: 12px;

                Note {
                    text: (root.problem ? Locale.t("Build stopped") : root.done ? "✓  " + Locale.t("Built and installed") : Locale.t("Building")) + " " + Game.pending-tag;
                    color: root.problem ? Ink.sand : root.done ? Ink.sage : Ink.mustard;
                }

                PosterTitle {
                    text: root.problem ? Locale.t("The build\nstopped.") : root.done ? Locale.t("Your game is ready.") : Locale.t("Building your game.");
                    font-size: root.problem ? min(90px,root.width * 0.075) : min(60px,root.width * 0.047);
                }

                Note {
                    text: root.problem ? Game.status : root.done ? Locale.t("Built and installed. Your game is ready to play.") : Locale.t("You can keep using your PC while Longshot builds your game.");
                    font-size: 17px;
                    color: Ink.text;
                }

                if root.problem: Note {
                    text: Locale.t("Your profile keeps its saves in a separate folder.");
                    color: Ink.sage;
                }
                if root.problem: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;

                    GameAction {
                        text: Locale.t("Try again");
                        primary: true;
                        enabled: !BuildReport.reporting;
                        clicked => { Game.start(); }
                    }

                    GameAction {
                        text: Locale.t("Review build settings");
                        enabled: !BuildReport.reporting;
                        clicked => { Game.step = GameStep.settings; Game.status = ""; }
                    }
                }
                if !root.problem: ReleaseBody {
                    vertical-stretch: 1;
                    end-padding: 16px;
                    body: root.notes;
                }
                if root.problem: Rectangle {
                    vertical-stretch: 1;
                }
                if root.problem: Rectangle {
                    height: 5px;
                    background: Ink.raised;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: 100%;
                        width: max(0,Game.overall) * parent.width;
                        background: Ink.russet;
                    }
                }
            }
        }

        SidePanel {
            horizontal-stretch: 1;

            VerticalLayout {
                padding: Ink.panel-inset(Ink.detail-width(root.width));
                spacing: 9px;

                Kicker {
                    text: root.problem ? Locale.t("BUILD DETAILS") : root.done ? Locale.t("BUILD COMPLETE") : Locale.t("BUILD PROGRESS");
                }

                if !root.problem: BuildGauge { }
                if !root.problem && !root.done: Note {
                    visible: !Game.finalizing;
                    text: Game.eta == "" ? Locale.t("Estimating time remaining…") : Game.eta;
                    horizontal-alignment: center;
                    font-size: 13px;
                }
                Rule { }

                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        if !root.problem: VerticalLayout {
                            spacing: 8px;
                            for stage[idx] in Game.stage-rows: StageRow {
                                swatch: [Ink.sage, Ink.sand, Ink.mustard, Ink.russet, #735447][idx];
                                marker: stage.marker;
                                title: Locale.t(stage.title);
                                detail: stage.detail;
                            }
                            if Game.finalizing: StageRow {
                                swatch: Ink.sage;
                                marker: root.done ? "✓" : "●";
                                title: Locale.t("Finalizing");
                                detail: root.done ? "" : Locale.t(Game.status);
                            }
                            if Game.stage-rows.length == 0 && !Game.finalizing: Note {
                                text: root.done ? Locale.t("Build finished.") : Game.status;
                            }
                        }
                        if root.problem: Note {
                            text: Game.status;
                            color: Ink.sand;
                            font-family: "monospace";
                            font-size: 13px;
                        }
                        VerticalLayout {
                            padding-top: 10px;
                            GameAction {
                                text: Locale.t("Show build log") + "  ›";
                                align-left: true;
                                quiet: true;
                                clicked => { Game.show-log = true; }
                            }
                        }

                        if root.problem && BuildReport.report-preview != "": Rectangle {
                            height: 160px;
                            background: Ink.well;
                            border-width: report.has-focus ? 2px : 1px;
                            border-color: report.has-focus ? Ink.mustard : Ink.line;
                            border-radius: 8px;
                            forward-focus: report;
                            ScrollView {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                                report := TextInput {
                                    text: BuildReport.report-preview;
                                    single-line: false;
                                    read-only: true;
                                    wrap: word-wrap;
                                    color: Ink.text;
                                    selection-background-color: Ink.mustard;
                                    selection-foreground-color: Ink.black;
                                    font-size: 14px;
                                    accessible-label: Locale.t("Report preview");
                                }
                            }
                        }
                    }
                }

                if root.problem && BuildReport.can-report: VerticalLayout {
                    spacing: 6px;

                    Label {
                        text: Locale.t("Report this problem");
                    }

                    Note {
                        text: Locale.t("Review the version, system and build stages before sending.");
                        font-size: 13px;
                    }

                    GameAction {
                        text: BuildReport.report-preview == "" ? Locale.t("Preview report") : BuildReport.reporting ? Locale.t("Sending") : BuildReport.report-sent ? Locale.t("Sent") : Locale.t("Send report");
                        enabled: !BuildReport.reporting && !BuildReport.report-sent;
                        clicked => { if BuildReport.report-preview == "" { BuildReport.preview-report(); } else { BuildReport.send-report(); } }
                    }

                    GameAction {
                        text: Locale.t("Save local diagnostics");
                        quiet: true;
                        clicked => { BuildReport.save-diagnostic(); }
                    }

                    if BuildReport.report-status != "": Note {
                        text: BuildReport.report-status;
                    }
                }
                if root.problem && !BuildReport.can-report: GameAction {
                    text: Locale.t("Save local diagnostics");
                    clicked => { BuildReport.save-diagnostic(); }
                }
                if Game.step == GameStep.building: VerticalLayout {
                    padding-bottom: 8px;
                    CheckBox {
                        text: Locale.t("Play after build");
                        checked <=> Game.play-after-build;
                        enabled: !Game.playing;
                    }
                }
                if !root.problem && !root.done: GameAction {
                    text: Locale.t("Cancel build");
                    danger: true;
                    clicked => { Game.confirm-stop(); }
                }
                if root.done: GameAction {
                    text: Locale.t("Play Longshot");
                    primary: true;
                    enabled: !Game.playing;
                    clicked => { Game.play-completed-build(); }
                }
                if root.done: GameAction {
                    text: Locale.t("Continue to Home");
                    quiet: true;
                    clicked => { Game.show-home(); }
                }
            }
        }
    }


}
