<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.App"
             RequestedThemeVariant="Dark">
  <!-- The launcher's cool dark look (the 2.x Builder's "Slate", flat: no glows, no gradients) with MagicBean's brand as accents
       (MagicBeanDev/Brand): the four stripes once at the window's top, lime, gold, leaf green for Play, and Noto Sans Black for
       the one big title of a page -->
  <Application.Resources>
    <ResourceDictionary>
      <!-- the brand's colours, by their names there -->
      <Color x:Key="NightColor">#21140D</Color>
      <SolidColorBrush x:Key="Night" Color="#21140D"/>
      <SolidColorBrush x:Key="Night2" Color="#2E1D13"/>
      <SolidColorBrush x:Key="Rust" Color="#A8472B"/>
      <SolidColorBrush x:Key="RustDark" Color="#7C3220"/>
      <SolidColorBrush x:Key="Cream" Color="#FBF1DC"/>
      <SolidColorBrush x:Key="CreamCard" Color="#FFF8E8"/>
      <SolidColorBrush x:Key="CreamLine" Color="#E6D3AE"/>
      <SolidColorBrush x:Key="CreamInk" Color="#2A1A10"/>
      <SolidColorBrush x:Key="CreamMuted" Color="#6E5643"/>
      <SolidColorBrush x:Key="Lime" Color="#C2ED83"/>
      <SolidColorBrush x:Key="Leaf" Color="#7CC242"/>
      <SolidColorBrush x:Key="Deep" Color="#3C651E"/>
      <SolidColorBrush x:Key="Gold" Color="#F3C24F"/>
      <SolidColorBrush x:Key="Tan" Color="#EFD3A6"/>
      <SolidColorBrush x:Key="Orange" Color="#D9783A"/>
      <!-- the palette (builder/LongshotBuilder/App.xaml) -->
      <SolidColorBrush x:Key="Page" Color="#14161A"/>
      <SolidColorBrush x:Key="Raised" Color="#1C1F24"/>
      <SolidColorBrush x:Key="RaisedHover" Color="#23272D"/>
      <SolidColorBrush x:Key="Line" Color="#2C3037"/>
      <SolidColorBrush x:Key="LineStrong" Color="#3D434C"/>
      <SolidColorBrush x:Key="Ink" Color="#EDEFF2"/>
      <SolidColorBrush x:Key="InkSoft" Color="#A2A9B3"/>
      <SolidColorBrush x:Key="InkFaint" Color="#6E7681"/>
      <SolidColorBrush x:Key="Brand" Color="#3D63E6"/>
      <SolidColorBrush x:Key="BrandHover" Color="#4B70F0"/>
      <SolidColorBrush x:Key="BrandInk" Color="#DFE6FF"/>
      <SolidColorBrush x:Key="Go" Color="#7CC242"/>
      <SolidColorBrush x:Key="GoHover" Color="#8DD253"/>
      <SolidColorBrush x:Key="GoInk" Color="#13210D"/>
      <SolidColorBrush x:Key="Warn" Color="#E2B86B"/>
      <SolidColorBrush x:Key="Bad" Color="#E2776B"/>
      <SolidColorBrush x:Key="Accent" Color="#5FB08A"/>
      <SolidColorBrush x:Key="Glass" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="GlassHover" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="GlassLine" Color="#17FFFFFF"/>
      <SolidColorBrush x:Key="GlassLineStrong" Color="#2AFFFFFF"/>
      <SolidColorBrush x:Key="GoSoft" Color="#265FB08A"/>
      <SolidColorBrush x:Key="BadSoft" Color="#26E2776B"/>
      <SolidColorBrush x:Key="WarnSoft" Color="#1FE2B86B"/>
      <SolidColorBrush x:Key="BrandSoft" Color="#333D63E6"/>
      <!-- small text that must be read (InkFaint is for disabled text and decoration only) -->
      <SolidColorBrush x:Key="InkFaintText" Color="#8A919B"/>
      <!-- the literals App.xaml uses inline -->
      <SolidColorBrush x:Key="ChipFill" Color="#0DFFFFFF"/>
      <SolidColorBrush x:Key="ChipLine" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="QuietFill" Color="#08FFFFFF"/>
      <SolidColorBrush x:Key="QuietLine" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="PrimaryLine" Color="#33FFFFFF"/>
      <SolidColorBrush x:Key="GoLine" Color="#40FFFFFF"/>
      <SolidColorBrush x:Key="RowHover" Color="#08FFFFFF"/>
      <SolidColorBrush x:Key="TickLine" Color="#40FFFFFF"/>
      <SolidColorBrush x:Key="BarTrack" Color="#12FFFFFF"/>
      <SolidColorBrush x:Key="DisabledFill" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="CaptionInk" Color="#80FFFFFF"/>
      <SolidColorBrush x:Key="InfoInk" Color="#B9C8FF"/>
      <SolidColorBrush x:Key="Selected" Color="#143D63E6"/>
      <SolidColorBrush x:Key="SoftNum" Color="#0FFFFFFF"/>
      <!-- pressed: a step darker than hover -->
      <SolidColorBrush x:Key="QuietPressed" Color="#05FFFFFF"/>
      <SolidColorBrush x:Key="BrandPressed" Color="#3357D0"/>
      <SolidColorBrush x:Key="GoPressed" Color="#6AAE36"/>
      <SolidColorBrush x:Key="BadHover" Color="#EC8B80"/>
      <SolidColorBrush x:Key="BadPressed" Color="#D2685C"/>
      <!-- Windows' own close red -->
      <SolidColorBrush x:Key="CloseHover" Color="#C42B1C"/>
      <SolidColorBrush x:Key="ClosePressed" Color="#A8261A"/>
      <!-- the keyboard / controller focus ring: a light brand ring (8:1 on the page), 2 px clear of the control -->
      <SolidColorBrush x:Key="FocusRing" Color="#F3C24F"/>
      <BoxShadows x:Key="PrimaryGlow">0 0 0 0 Transparent</BoxShadows>
      <BoxShadows x:Key="GoGlow">0 3 0 0 #66000000</BoxShadows>
      <!-- the brand's accents (MagicBeanDev/Brand), over v8's cool dark palette: lime for the version and good states, gold
           for focus and small kickers, leaf green for Play -->
      <BoxShadows x:Key="PlayShadow">0 3 0 0 #66000000</BoxShadows>
      <!-- digits all one width, so versions, sizes, times and percentages do not jitter as they change -->
      <FontFeatureCollection x:Key="Tabular">
        <FontFeature>+tnum</FontFeature>
      </FontFeatureCollection>
      <FontFamily x:Key="Ui">avares://LongshotLauncher/Assets/Fonts#Inter</FontFamily>
      <!-- the brand's headings: Noto Sans Black (the announcement's face where Segoe UI Black is not installed) -->
      <FontFamily x:Key="Head">avares://LongshotLauncher/Assets/Fonts#Noto Sans</FontFamily>
      <FontFamily x:Key="Mono">Cascadia Mono, Consolas, JetBrains Mono, DejaVu Sans Mono, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme/>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>

    <!-- type, one scale: 11 (small chips), 12 (faint), 13 (notes, section and field names), 14 (body), 16, 18 (dialog titles), 24 (headings),
         34 (the game's name), 40 (a build's percentage); weights Medium, SemiBold, Bold -->
    <Style Selector="TextBlock.heading">
      <Setter Property="FontFamily" Value="{StaticResource Head}"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="LetterSpacing" Value="-0.9"/>
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="-0.5"/>
    </Style>
    <!-- the brand's kicker: a short line in capitals, gold, tracked wide, in a gold-outlined pill -->
    <Style Selector="Border.kicker">
      <Setter Property="BorderBrush" Value="#66F3C24F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Border.kicker > TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
    </Style>
    <Style Selector="Border.kicker.go">
      <Setter Property="BorderBrush" Value="#66C2ED83"/>
    </Style>
    <Style Selector="Border.kicker.go > TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Lime}"/>
    </Style>
    <!-- the brand's four stripes: rust, orange, gold, leaf -->
    <Style Selector="UniformGrid.stripes">
      <Setter Property="Rows" Value="1"/>
      <Setter Property="Height" Value="6"/>
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="TextBlock.faint, TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <!-- a section's or a field's name, in sentence case: 13, SemiBold, a step softer than the text it names -->
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="Margin" Value="0,24,0,10"/>
    </Style>
    <Style Selector="TextBlock.strong">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- a path: one line, its middle folders dropped for an ellipsis when it does not fit (the whole path in its tooltip) -->
    <Style Selector="TextBlock.path">
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="PathSegmentEllipsis"/>
    </Style>
    <!-- numbers that change in place or stand in a column: a build's percentage and times, sizes, the saves' dates -->
    <Style Selector="TextBlock.tnum">
      <Setter Property="FontFeatures" Value="{StaticResource Tabular}"/>
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource Go}"/>
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{StaticResource Bad}"/>
    </Style>
    <Style Selector="TextBlock.ellipsis">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="c|ScrollEdge">
      <Setter Property="Background" Value="{StaticResource GlassLineStrong}"/>
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{StaticResource GlassLine}"/>
    </Style>

    <!-- chips: a pill, the radius half the height -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource ChipFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ChipLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="TextElement.FontSize" Value="12"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.chip.quiet">
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="TextElement.FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Border.chip.small">
      <Setter Property="Height" Value="20"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="TextElement.FontSize" Value="11"/>
    </Style>
    <Style Selector="Border.chip.go">
      <Setter Property="Background" Value="{StaticResource GoSoft}"/>
      <Setter Property="BorderBrush" Value="#407CC242"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Go}"/>
    </Style>
    <Style Selector="Border.chip.warn">
      <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
      <Setter Property="BorderBrush" Value="#38F3C24F"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Warn}"/>
    </Style>
    <Style Selector="Border.chip.bad">
      <Setter Property="Background" Value="{StaticResource BadSoft}"/>
      <Setter Property="BorderBrush" Value="#40EC7A5F"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Bad}"/>
    </Style>
    <Style Selector="Border.chip.ink">
      <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <!-- "Update available": a build with a newer version on its channel (the home's Version field and list, and its row) -->
    <Style Selector="Border.chip.update">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="BorderBrush" Value="#503D63E6"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource BrandInk}"/>
    </Style>

    <!-- a build's channel: release (green), nightly (blue) -->
    <Style Selector="Border.tag">
      <Setter Property="Height" Value="20"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextElement.FontSize" Value="12"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{StaticResource GoSoft}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Go}"/>
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.tag.nightly">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <!-- a pull request's build (red: code that is not in a release) -->
    <Style Selector="Border.tag.pr">
      <Setter Property="Background" Value="{StaticResource BadSoft}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Bad}"/>
    </Style>

    <!-- buttons: quiet (glass), primary (blue: the step's action), go (green: Play), bad (red: delete), link, icon, caption -->
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,0"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource QuietFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource QuietLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
          <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
        </Transitions>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLineStrong}"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="{StaticResource QuietPressed}"/>
      <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryLine}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="20,0"/>
    </Style>
    <Style Selector="Button.primary /template/ Border#Bd">
      <Setter Property="BoxShadow" Value="{StaticResource PrimaryGlow}"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{StaticResource BrandHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryLine}"/>
    </Style>
    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="{StaticResource BrandPressed}"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Background" Value="{StaticResource DisabledFill}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ Border#Bd">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    </Style>
    <Style Selector="Button.go">
      <Setter Property="Height" Value="50"/>
      <Setter Property="Padding" Value="34,0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{StaticResource Go}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GoLine}"/>
      <Setter Property="Foreground" Value="{StaticResource GoInk}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.go /template/ Border#Bd">
      <Setter Property="BoxShadow" Value="{StaticResource GoGlow}"/>
    </Style>
    <Style Selector="Button.go:pointerover">
      <Setter Property="Background" Value="{StaticResource GoHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GoLine}"/>
    </Style>
    <Style Selector="Button.go:pressed">
      <Setter Property="Background" Value="{StaticResource GoPressed}"/>
    </Style>
    <Style Selector="Button.go:disabled">
      <Setter Property="Background" Value="{StaticResource DisabledFill}"/>
      <Setter Property="Foreground" Value="{StaticResource InkFaint}"/>
    </Style>
    <Style Selector="Button.go:disabled /template/ Border#Bd">
      <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
    </Style>
    <Style Selector="Button.tall">
      <Setter Property="Height" Value="50"/>
      <Setter Property="Padding" Value="26,0"/>
    </Style>
    <!-- a button beside Play on the home (Update): Play's size, padding, corners and type, in its own colour -->
    <Style Selector="Button.hero">
      <Setter Property="Height" Value="50"/>
      <Setter Property="Padding" Value="34,0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!-- a button's label while its work runs (Controls.BusyContent, Core/BusyCommand.cs): the spinner and what it is doing -->
    <Style Selector="c|BusyContent">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="Idle" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Name="Busy" Orientation="Horizontal" Spacing="8" IsVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center">
              <c:Spinner VerticalAlignment="Center"/>
              <TextBlock Text="{TemplateBinding BusyText}" VerticalAlignment="Center"/>
            </StackPanel>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="c|BusyContent[IsBusy=true] /template/ ContentPresenter#Idle">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="c|BusyContent[IsBusy=true] /template/ StackPanel#Busy">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="Button.primary.small /template/ Border#Bd">
      <Setter Property="BoxShadow" Value="0 4 14 0 #663D63E6"/>
    </Style>
    <Style Selector="Button.bad">
      <Setter Property="Background" Value="{StaticResource Bad}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryLine}"/>
      <Setter Property="Foreground" Value="{StaticResource Page}"/>
    </Style>
    <Style Selector="Button.bad:pointerover">
      <Setter Property="Background" Value="{StaticResource BadHover}"/>
    </Style>
    <Style Selector="Button.bad:pressed">
      <Setter Property="Background" Value="{StaticResource BadPressed}"/>
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="Button.icon:pointerover">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Button.icon:pressed">
      <Setter Property="Background" Value="{StaticResource QuietFill}"/>
    </Style>
    <Style Selector="Button.icon.iconbad:pointerover">
      <Setter Property="Background" Value="{StaticResource BadSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource Bad}"/>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.link:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.link:pressed">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="RenderTransform" Value="none"/>
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
    <Style Selector="Button.link.soft">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="Button.link.soft:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Button.link.smaller">
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <!-- a link that cannot be pressed now (its work, or another, runs: BusyCommand) reads as off, as the other buttons do -->
    <Style Selector="Button.link:disabled">
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <!-- the title bar's buttons: round and inset, one style on every platform and page (MainWindow's StackPanel.captions);
         Close turns red under the pointer, as Windows' does -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource CaptionInk}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Button.caption c|Icon">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="Button.caption.gear c|Icon">
      <Setter Property="Width" Value="17"/>
      <Setter Property="Height" Value="17"/>
    </Style>
    <Style Selector="Button.caption:pointerover">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Button.caption:pressed">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Button.caption.close:pointerover">
      <Setter Property="Background" Value="{StaticResource CloseHover}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.caption.close:pressed">
      <Setter Property="Background" Value="{StaticResource ClosePressed}"/>
    </Style>
    <Style Selector="StackPanel.captions">
      <Setter Property="Spacing" Value="10"/>
      <Setter Property="Margin" Value="0,18,20,0"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource ChipFill}"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption c|Icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Weight" Value="1.6"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption.gear">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption.gear c|Icon">
      <Setter Property="Weight" Value="1"/>
    </Style>
    <!-- the title bar's tabs: an icon over a small label (the size of the launcher's version beside its name), as wide as
         the label needs -->
    <Style Selector="Button.caption.nav">
      <Setter Property="Width" Value="NaN"/>
      <Setter Property="MinWidth" Value="50"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="Padding" Value="8,4,8,0"/>
    </Style>
    <Style Selector="StackPanel.navitem">
      <Setter Property="Spacing" Value="2"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.caption.gear.nav c|Icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.navlabel">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption.nav">
      <Setter Property="Width" Value="NaN"/>
      <Setter Property="MinWidth" Value="50"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption.gear.nav c|Icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
    </Style>
    <!-- the title bar's tab of the page shown: lit and filled, one style on every platform (StackPanel.captions) -->
    <Style Selector="Button.caption.nav.on">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
      <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>
    <Style Selector="StackPanel.captions StackPanel#NavBar">
      <Setter Property="Spacing" Value="10"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption.nav.on">
      <Setter Property="Background" Value="{StaticResource ChipFill}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption:pointerover, StackPanel.captions Button.caption.close:pointerover">
      <Setter Property="Background" Value="{StaticResource GlassLineStrong}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption.close:pointerover">
      <Setter Property="Background" Value="{StaticResource CloseHover}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="StackPanel.captions Button.caption:pressed, StackPanel.captions Button.caption.close:pressed">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
    </Style>
    <!-- a page's Back, in its header: a round arrow left of the title, level with it (Panel.backslot; the title is 52 in), and
         B's glyph on its corner while a controller is in use (Window.pad: the TV view, or once a controller was pressed) -->
    <Style Selector="Panel.backslot">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,-1,0,0"/>
    </Style>
    <Style Selector="Button.back">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="{StaticResource QuietFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource QuietLine}"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="Button.back:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Button.back c|Icon">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
    </Style>
    <Style Selector="Border.bglyph">
      <Setter Property="IsVisible" Value="False"/>
      <Setter Property="Width" Value="17"/>
      <Setter Property="Height" Value="17"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="{StaticResource Ink}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Margin" Value="0,0,-5,-5"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Page}"/>
      <Setter Property="TextElement.FontSize" Value="10"/>
      <Setter Property="TextElement.FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Border.bglyph TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Window.pad Border.bglyph">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- a page's facts under its title: one small line, muted (a path, where its files stay) -->
    <Style Selector="StackPanel.meta">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="Spacing" Value="7"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style Selector="StackPanel.meta c|Icon">
      <Setter Property="Width" Value="13"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="StackPanel.meta TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- a whole row that is a button (a version in the list, Advanced's head) -->
    <Style Selector="Button.row">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.row:pointerover">
      <Setter Property="Background" Value="{StaticResource RowHover}"/>
    </Style>
    <Style Selector="Button.row:pressed">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <!-- a switch: 38x22, on in brand blue -->
    <Style Selector="ToggleButton.switch">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Track" Width="38" Height="22" CornerRadius="11" Background="#1FFFFFFF" BorderThickness="1"
                  BorderBrush="{StaticResource GlassLineStrong}">
            <Ellipse Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{StaticResource InkSoft}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch /template/ Border#Track">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch /template/ Ellipse#Knob">
      <Setter Property="Transitions">
        <Transitions>
          <ThicknessTransition Property="Margin" Duration="0:0:0.14" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrandHover}"/>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Ellipse#Knob">
      <Setter Property="Margin" Value="19,0,0,0"/>
      <Setter Property="Fill" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.switch:pointerover /template/ Border#Track">
      <Setter Property="Background" Value="#2BFFFFFF"/>
    </Style>
    <Style Selector="ToggleButton.switch:pointerover /template/ Ellipse#Knob">
      <Setter Property="Fill" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="ToggleButton.switch:checked:pointerover /template/ Border#Track">
      <Setter Property="Background" Value="{StaticResource BrandHover}"/>
    </Style>
    <Style Selector="ToggleButton.switch:disabled">
      <Setter Property="Opacity" Value="0.4"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- a tick box -->
    <Style Selector="CheckBox.tick">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="18,*" Background="Transparent">
            <Border Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource TickLine}"
                    VerticalAlignment="Top" Margin="0,2,0,0">
              <c:Icon Name="Mark" Kind="check" Width="14" Height="14" Foreground="White" Opacity="0"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.tick:checked /template/ Border#Box">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>
    <Style Selector="CheckBox.tick:checked /template/ c|Icon#Mark">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="CheckBox.tick:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="CheckBox.tick:checked:pointerover /template/ Border#Box">
      <Setter Property="Background" Value="{StaticResource BrandHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrandHover}"/>
    </Style>
    <Style Selector="CheckBox.tick:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- radio rows: the found game files (row), the dialogs' options (chan), the settings' channel (seg) -->
    <Style Selector="RadioButton.row, RadioButton.chan">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="18,*">
              <Border Name="Ring" Width="18" Height="18" CornerRadius="9" BorderThickness="2" BorderBrush="{StaticResource InkFaint}" VerticalAlignment="Center">
                <Ellipse Name="Dot" Width="8" Height="8" Fill="{StaticResource Brand}" IsVisible="False"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="14,0,0,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.row:pointerover">
      <Setter Property="Background" Value="{StaticResource RowHover}"/>
    </Style>
    <Style Selector="RadioButton.row:pointerover /template/ Border#Ring">
      <Setter Property="BorderBrush" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="RadioButton:checked /template/ Border#Ring">
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>
    <Style Selector="RadioButton:checked /template/ Ellipse#Dot">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="RadioButton:disabled /template/ Border#Ring">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="RadioButton:disabled">
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="RadioButton.row:disabled">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="RadioButton.chan">
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="Background" Value="{StaticResource Glass}"/>
    </Style>
    <Style Selector="RadioButton.chan.compact">
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style Selector="RadioButton.chan:pointerover">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
    </Style>
    <Style Selector="RadioButton.chan:checked">
      <Setter Property="Background" Value="#1F3D63E6"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>
    <Style Selector="RadioButton.chan:disabled">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
    </Style>
    <Style Selector="RadioButton.seg">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Padding="14,10" CornerRadius="8" BorderThickness="1" Background="{StaticResource QuietFill}" BorderBrush="{StaticResource QuietLine}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.seg:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
    </Style>
    <Style Selector="RadioButton.seg:checked /template/ Border#Bd">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>

    <!-- dropdowns -->
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource QuietFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource QuietLine}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Padding" Value="12,0,8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ComboBox.dd">
      <Setter Property="Width" Value="184"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
    <!-- (a choice longer than its dropdown, as a translation can be: cut with an ellipsis, whole in the open list) -->
    <Style Selector="ComboBox.dd TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLineStrong}"/>
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- a list's rows in the launcher's colours, not Fluent's accent: the picked one in the brand's soft fill -->
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4D3D63E6"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>

    <!-- a folder's path, in mono -->
    <Style Selector="TextBox.path">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <!-- a path only shown (TextBox.path's look): cut in its middle when it does not fit (TextTrimming="PathSegmentEllipsis") -->
    <Style Selector="Border.pathbox">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.pathbox > TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.path:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLineStrong}"/>
    </Style>
    <Style Selector="TextBox.path:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>

    <!-- progress: the bar eases to its new value rather than jumping -->
    <Style Selector="c|Bar">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Value" Duration="0:0:0.3" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- a dialog arrives: a quick fade and a few pixels' rise -->
    <Style Selector="Window:not(.still) Border.dialog">
      <Style.Animations>
        <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.Y" Value="8"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="TranslateTransform.Y" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!-- focus rings, shown for the keyboard and a controller only (:focus-visible): drawn over the window, so a card's clip
         does not cut them; each follows its control's corners, 4 px out (rows: 2 px in, inside their card) -->
    <Style Selector="Button">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-4" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.small, Button.icon, Button.back">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-4" CornerRadius="11" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.go, Button.tall">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-4" CornerRadius="14" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.link">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-4,-2" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.row">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="2" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.caption.gear">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="2" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="StackPanel.captions Button.caption.gear">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-3" CornerRadius="17" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-4" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="CheckBox.tick">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-4,-3" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.row">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="2" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.chan, RadioButton.seg, ComboBox">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-4" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="FocusAdorner">
        <FocusAdornerTemplate>
          <Border AdornerLayer.IsClipEnabled="False" Margin="-8,-6" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource FocusRing}"/>
        </FocusAdornerTemplate>
      </Setter>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <!-- a stronger warning box: a pull request nobody approved -->
    <Style Selector="Border.badbox">
      <Setter Property="Background" Value="{StaticResource BadSoft}"/>
      <Setter Property="BorderBrush" Value="#55EC7A5F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,16,0,0"/>
      <Setter Property="TextElement.FontSize" Value="13"/>
    </Style>

    <!-- a warning box -->
    <Style Selector="Border.warnbox">
      <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
      <Setter Property="BorderBrush" Value="#55F3C24F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,16,0,0"/>
      <Setter Property="TextElement.FontSize" Value="13"/>
    </Style>

    <!-- a warning box's icon: a small circle in the box's colour, centred on the text beside it (the Home cards' offericon, smaller) -->
    <Style Selector="Border.boxicon">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Background" Value="#33F3C24F"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- (a box's text beside its icon: centred on it, so one line sits level with the icon) -->
    <Style Selector="Border.warnbox > Grid > TextBlock, Border.badbox > Grid > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badbox Border.boxicon">
      <Setter Property="Background" Value="#33EC7A5F"/>
    </Style>
    <!-- a toast: a raised card with its icon in a circle -->
    <!-- ==== the home family (HomeView, BuildCardView, VersionsView): a dark band with a faint rust tint (the game's name, its
         version in lime, the logo tilted), the Version and Save pickers under it, and the one button ==== -->
    <Style Selector="Border.heroband">
      <Setter Property="Background" Value="#211D1E"/>
      <Setter Property="BorderBrush" Value="#3A2B27"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="ClipToBounds" Value="True"/>
    </Style>
    <Style Selector="Image.bandlogo">
      <Setter Property="Width" Value="150"/>
      <Setter Property="Height" Value="150"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <!-- the logo, tilted as on the brand's announcement -->
    <Style Selector="Image.tilted">
      <Setter Property="RenderTransform" Value="rotate(8deg)"/>
    </Style>
    <!-- the page's one big title, in the brand's black face -->
    <Style Selector="TextBlock.wordmark">
      <Setter Property="FontFamily" Value="{StaticResource Head}"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="FontSize" Value="60"/>
      <Setter Property="LetterSpacing" Value="-2.2"/>
      <Setter Property="Margin" Value="0,-8,0,-4"/>
    </Style>
    <Style Selector="TextBlock.versionline">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="-0.4"/>
    </Style>
    <Style Selector="TextBlock.lime">
      <Setter Property="Foreground" Value="{StaticResource Lime}"/>
    </Style>
    <Style Selector="Border.heroband TextBlock.soft">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <!-- the update, on the band -->
    <Style Selector="Border.updatecard">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="BorderBrush" Value="#553D63E6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- a tile under the band: flat, its caption small, gold and in capitals -->
    <Style Selector="Border.infotile">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,12"/>
    </Style>
    <Style Selector="TextBlock.tilecap">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="LetterSpacing" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Gold}"/>
    </Style>
    <Style Selector="TextBlock.tilebig">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- a save in Home's list: the whole row picks it; the one Play starts on lit -->
    <Style Selector="Button.saverow">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Background" Value="{StaticResource QuietFill}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.saverow.chosen">
      <Setter Property="Background" Value="#14C2ED83"/>
      <Setter Property="BorderBrush" Value="#40C2ED83"/>
    </Style>
    <!-- the card Play is on: flat, a step lighter than the page -->
    <Style Selector="Border.playcard">
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18,14,18,16"/>
    </Style>
    <!-- a list's last entries that lead to a page or make something (Manage…, New…) -->
    <Style Selector="StackPanel.manage TextBlock">
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="StackPanel.manage c|Icon">
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>

    <Style Selector="TextBlock.pickercap">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
      <Setter Property="Margin" Value="2,0,0,6"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="ComboBox.picker">
      <Setter Property="Width" Value="NaN"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ComboBox.picker TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- (a name that must not be cut: it wraps instead) -->
    <Style Selector="ComboBox.picker TextBlock.wrap">
      <Setter Property="TextTrimming" Value="None"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <Style Selector="Border.fieldbox">
      <Setter Property="Height" Value="46"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource QuietFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource QuietLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.fieldbox">
      <Setter Property="Height" Value="50"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Background" Value="{StaticResource QuietFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource QuietLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.fieldbox:pointerover">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLineStrong}"/>
    </Style>
    <!-- Play on Home, the card's focus -->
    <Style Selector="Button.bigplay">
      <Setter Property="Height" Value="66"/>
      <Setter Property="MinWidth" Value="210"/>
      <Setter Property="Padding" Value="30,0"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <!-- a cell of the first build's bar: an icon in a circle, a line and a quieter one -->
    <Style Selector="Border.need">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{StaticResource GoSoft}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <!-- a version's card on the Versions page: flat, the default's outlined in gold -->
    <!-- a manager page's card (Profiles, Versions, Saves): one style -->
    <Style Selector="Border.vcard">
      <Setter Property="Padding" Value="18,16"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.vcard.default">
      <Setter Property="BorderBrush" Value="#66F3C24F"/>
    </Style>
    <!-- the Profiles page's card of the current profile: outlined in the brand's colour -->
    <Style Selector="Border.vcard.current">
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>
    <Style Selector="Border.vtile">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource SoftNum}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBlock.pagesection">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- a small menu (a popup under its button) -->
    <Style Selector="Border.menu">
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="BoxShadow" Value="0 14 34 0 #80000000"/>
    </Style>
    <!-- a profile's card on Who's playing? -->
    <Style Selector="Button.whocard">
      <Setter Property="Width" Value="190"/>
      <Setter Property="Height" Value="196"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <!-- the profile chip in the title bar, and a profile's avatar: a circle in its colour with its letter -->
    <Style Selector="Button.profilechip">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="5,0,12,0"/>
      <Setter Property="CornerRadius" Value="19"/>
      <Setter Property="Background" Value="{StaticResource ChipFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
    </Style>
    <Style Selector="Border.avatar">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="Border.avatar > TextBlock">
      <Setter Property="Foreground" Value="#14161A"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.avatar.small">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="13"/>
    </Style>
    <Style Selector="Border.avatar.big">
      <Setter Property="Width" Value="84"/>
      <Setter Property="Height" Value="84"/>
      <Setter Property="CornerRadius" Value="42"/>
    </Style>
    <Style Selector="Border.avatar.big > TextBlock">
      <Setter Property="FontSize" Value="36"/>
    </Style>
    <Style Selector="Border.avatar.card">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="CornerRadius" Value="23"/>
    </Style>
    <Style Selector="Border.avatar.card > TextBlock">
      <Setter Property="FontSize" Value="19"/>
    </Style>
    <!-- a small menu's entries (the profile chip's, a save's Copy or move) -->
    <Style Selector="Button.menuitem">
      <Setter Property="Height" Value="36"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.menuitem:pointerover">
      <Setter Property="Background" Value="{StaticResource GlassHover}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.menuitem c|Icon">
      <Setter Property="Width" Value="15"/>
      <Setter Property="Height" Value="15"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.menuitem TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.toast">
      <Setter Property="Padding" Value="10,8,16,8"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="BorderBrush" Value="#553D63E6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 12 30 0 #66000000"/>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- less motion when the desktop asks for it (Motion.cs): last, so it overrides every transition above -->
    <Style Selector="Window.still :is(Control), Window.still ToggleButton.switch /template/ :is(Control)">
      <Setter Property="Transitions" Value="{x:Null}"/>
    </Style>
  </Application.Styles>
</Application>
