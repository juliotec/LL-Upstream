<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.BuildFilesView"
             x:DataType="vm:BuildFilesViewModel">
  <Border Classes="dialog">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{Binding Title}"/>
      <TextBlock Classes="sub" Text="{Binding Sub}"/>
      <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="8" Background="#26000000" BorderBrush="{StaticResource GlassLine}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <c:Icon Kind="folder" Width="15" Height="15" Foreground="{StaticResource InkFaintText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Classes="mono path" Foreground="{StaticResource InkSoft}" Text="{Binding Folder}" ToolTip.Tip="{Binding FolderFull}"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <TextBlock Classes="hint" Margin="0,12,0,0" Text="{Binding Note}"/>
      <TextBlock Classes="hint" Margin="0,12,0,0" Text="{c:T 'Only the build files go: the folder, anything else in it, and your saves and their backups stay.'}"/>
      <StackPanel Classes="buttons">
        <Button Content="{c:T 'Keep them'}" Command="{Binding KeepCommand}" c:Pad.Back="True"/>
        <Button Classes="bad" Content="{Binding DeleteLabel}" Command="{Binding DeleteCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
