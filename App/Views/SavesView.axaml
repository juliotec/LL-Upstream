<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:core="using:LongshotLauncher.Core"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.SavesView"
             x:DataType="vm:SavesViewModel">
  <UserControl.Styles>
    <Style Selector="Button.transfer">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Height" Value="64"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
    </Style>
    <Style Selector="TextBlock.transferTitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="18">
    <Panel>
      <StackPanel>
        <TextBlock Classes="heading" Text="{c:T 'Saves'}"/>
        <TextBlock Classes="sub" Text="{Binding Sub}"/>
        <StackPanel Classes="meta">
          <c:Icon Kind="check" Foreground="{StaticResource Go}"/>
          <TextBlock Text="{c:T 'Existing saves are backed up before every transfer.'}"/>
        </StackPanel>
      </StackPanel>
    </Panel>

    <Grid Grid.Row="1" ColumnDefinitions="*,290" ColumnSpacing="24">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
          <TextBlock Classes="label" Text="{c:T 'Your Longshot saves'}" Margin="0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Classes="faint" Text="{Binding SlotCount}" VerticalAlignment="Center"/>
          <!-- the save folder in the file manager, to find the saves by hand -->
          <Button Grid.Column="2" Classes="link smaller" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding SaveFolderShown}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="folder" Width="13" Height="13"/>
              <TextBlock Text="{c:T 'Open saves folder'}"/>
            </StackPanel>
          </Button>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0" Padding="0,0,12,32">
          <StackPanel Spacing="10">
            <Border Classes="card" Padding="16,8">
              <Panel>
                <StackPanel IsVisible="{Binding NoSlots}" Spacing="6" Margin="0,18">
                  <TextBlock Text="{c:T 'Start where you left off'}" FontWeight="SemiBold"/>
                  <TextBlock Classes="note" Text="{Binding EmptyHint}" TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding SlotRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotRowViewModel">
                      <Grid ColumnDefinitions="26,*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Height="40">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SoftNum}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Classes="faint tnum" Text="{Binding Saved}" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Classes="small" Content="{c:T 'Progress'}" Command="{Binding ProgressCommand}" c:Pad.First="True"
                                ToolTip.Tip="{Binding Why}" ToolTip.ShowOnDisabled="True" VerticalAlignment="Center"/>
                        <!-- the save Play starts on: this profile's start slot, or the button that makes it so -->
                        <Border Grid.Column="4" Classes="chip small go" IsVisible="{Binding Starts}" VerticalAlignment="Center"
                                ToolTip.Tip="{c:T 'Play starts on this save, in a version that can'}">
                          <TextBlock Text="{c:T 'Play starts here'}"/>
                        </Border>
                        <Button Grid.Column="4" Classes="small" Content="{c:T 'Start here'}" Command="{Binding StartHereCommand}"
                                IsVisible="{Binding CanStartHere}" VerticalAlignment="Center"
                                ToolTip.Tip="{c:T 'Play starts on this save, in a version that can'}"/>
                        <!-- to another profile: Copy to or Move to, in a small menu (none with one profile) -->
                        <Button Grid.Column="5" Classes="small" IsVisible="{Binding CanMove}" VerticalAlignment="Center"
                                ToolTip.Tip="{c:T 'Copy or move this save to another profile'}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <c:Icon Kind="swap" Width="13" Height="13"/>
                            <TextBlock Text="{c:T 'Copy or move…'}"/>
                          </StackPanel>
                          <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                              <ItemsControl ItemsSource="{Binding Moves}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:SlotMoveViewModel">
                                    <StackPanel Spacing="2" Margin="0,2">
                                      <Button Classes="menuitem" Command="{Binding CopyCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Kind="plus"/><TextBlock Text="{Binding CopyText}"/></StackPanel>
                                      </Button>
                                      <Button Classes="menuitem" Command="{Binding MoveCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><c:Icon Kind="arrowRight"/><TextBlock Text="{Binding MoveText}"/></StackPanel>
                                      </Button>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </Border>
            <TextBlock Classes="faint" Text="{Binding EditorNote}" IsVisible="{Binding HasEditorNote}" TextWrapping="Wrap" Margin="4,0"/>
            <Button Classes="transfer" Command="{Binding BackupsCommand}" ToolTip.Tip="{Binding BackupsHint}" ToolTip.ShowOnDisabled="True">
              <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                <c:Icon Kind="clock" Width="18" Height="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Classes="transferTitle" Text="{c:T 'Restore from a backup…'}"/>
                  <TextBlock Classes="faint" FontSize="11.5" Text="{Binding BackupsHint}" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Button>
            <Expander Background="#0BFFFFFF" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" CornerRadius="10" Header="{Binding OtherSavesLabel}" IsVisible="{Binding HasOtherSaves}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding OtherSaves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaveRowViewModel">
                    <StackPanel Spacing="3" Margin="0,8">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Classes="faint" Text="{Binding Summary}" TextWrapping="Wrap"/>
                      <TextBlock Classes="faint path" Text="{Binding Where}" ToolTip.Tip="{Binding Where}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0" Padding="0,0,12,32">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{c:T 'Bring saves into Longshot'}" Margin="0,0,0,2"/>
          <Button Classes="transfer" Command="{Binding ImportCommand}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="download" Width="18" Height="18" VerticalAlignment="Center" Foreground="{StaticResource Brand}"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="{c:T 'From an emulator…'}"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="{c:T 'Choose an emulator, a save folder or a .zip'}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="transfer" Command="{Binding HookshotCommand}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="download" Width="18" Height="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="{c:T 'From Hookshot…'}"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="{c:T 'Bring over your Hookshot progress'}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Button>
          <TextBlock Classes="label" Text="{c:T 'Take your saves with you'}" Margin="0,10,0,2"/>
          <Button Classes="transfer" Command="{Binding ExportCommand}" ToolTip.Tip="{Binding ExportHint}" ToolTip.ShowOnDisabled="True">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="upload" Width="18" Height="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="{c:T 'Export saves…'}"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="{Binding ExportHint}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

  </Grid>
</UserControl>
