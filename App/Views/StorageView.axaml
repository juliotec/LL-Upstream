<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.StorageView"
             x:DataType="vm:StorageViewModel">
  <UserControl.Styles>
    <!-- the refresh beside the drive's free space (one drive): its icon centred on that text's letters, which sit at the
         row's foot on the heading's baseline (measured in the screenshots); beside the dropdown it is centred in the row as the
         dropdown is -->
    <Style Selector="Button.refresh.bytext">
      <!-- (down to the text's letters, its height unchanged: not a render transform, which a press replaces) -->
      <Setter Property="Margin" Value="0,9,0,-9"/>
    </Style>
    <!-- the bar's groups: their own colour, never the buttons' hover fill; the one shown at full strength, the rest dimmer -->
    <Style Selector="Button.seg">
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- the legend's cards: one line, the group's colour as their bottom edge -->
    <Style Selector="Button.legend">
      <!-- (as tall as the name, the size and their padding: not the 40 of every button, which ate the foot's padding) -->
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bd" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0"
                  CornerRadius="10,10,0,0" MinHeight="40" Padding="12,0">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.legend:pointerover /template/ Border#Bd">
      <Setter Property="Background" Value="{StaticResource RaisedHover}"/>
    </Style>
    <Style Selector="Button.legend.on /template/ Border#Bd">
      <Setter Property="Background" Value="{StaticResource Selected}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brand}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- pinned: the heading with the total and the drive, the groups' tabs and their bar -->
    <StackPanel DockPanel.Dock="Top" Spacing="12">
      <!-- (no Back: the title bar's tabs move between the pages, and a controller's B goes home) -->
      <Grid>
        <!-- (the heading and the total one text, on one baseline (no total until measured: the pinned progress says so); the
             drive's free space on it too: both at the row's foot, the smaller text raised by what its descent lacks of the heading's) -->
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center" MinHeight="40">
          <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
            <Run Text="{c:T 'Storage'}" FontSize="24" FontWeight="Bold"/>
            <Run Text="   " FontSize="24"/>
            <Run Text="{Binding TotalText}" FontSize="24" FontWeight="Bold"/>
          </TextBlock>
          <TextBlock Grid.Column="1" FontSize="13" Foreground="{StaticResource InkFaintText}" Text="{Binding DriveText}"
                     VerticalAlignment="Bottom" Margin="0,0,0,4" IsVisible="{Binding !ShowDrives}"/>
          <!-- (more than one drive: all of them, or one picked, with what Longshot keeps on it and its free space) -->
          <ComboBox Grid.Column="1" Classes="dd" Width="NaN" MinWidth="200" VerticalAlignment="Center" IsVisible="{Binding ShowDrives}"
                    ItemsSource="{Binding DriveOptions}" SelectedItem="{Binding PickedDrive}" AutomationProperties.Name="{c:T 'Drive shown'}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StorageViewModel+DriveOption">
                <TextBlock>
                  <Run Text="{Binding Name}" FontWeight="SemiBold"/>
                  <Run Text="  "/>
                  <Run Text="{Binding Detail}" Foreground="{StaticResource InkSoft}"/>
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- (the sizes are the last measure, kept while the launcher is open: measured again here, its tip says when) -->
          <Button Grid.Column="2" Classes="icon refresh" Classes.bytext="{Binding !ShowDrives}" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding RefreshTip}" ToolTip.ShowOnDisabled="True" AutomationProperties.Name="{c:T 'Measure again'}">
            <c:Icon Kind="refresh"/>
          </Button>
        </Grid>
      </Grid>
      <!-- (the tabs on the bar: their flat feet, each with its group's colour, sit above what they pick) -->
      <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding Segments}">
          <ItemsControl.ItemsPanel>
            <!-- (equal shares, not a UniformGrid: its cells, each rounded up, came out 2 px wider than the row and cut the last tab's edge) -->
            <ItemsPanelTemplate><c:ShareRow Spacing="6" MinChild="0"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StorageViewModel+Segment">
              <StackPanel>
                <Button Classes="legend" Classes.on="{Binding IsSelected}" Command="{Binding Pick}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding ShareText}">
                  <!-- (the launcher's window leaves a card ~150 px: the name over its size, each one line) -->
                  <!-- (a little more below than above: the colour edge under the card reads as part of its foot) -->
                  <StackPanel Spacing="1" Margin="0,7,0,10">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource InkSoft}"/>
                  </StackPanel>
                </Button>
                <Border Height="3" Background="{Binding Fill}" CornerRadius="0,0,3,3"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- (not while the first measure runs: nothing to show yet, and its progress below takes the bar's place) -->
        <Border CornerRadius="10" ClipToBounds="True" Height="40" IsVisible="{Binding !Measuring}">
          <ItemsControl ItemsSource="{Binding BarSegments}" AutomationProperties.Name="{c:T 'Space by what it is for'}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><c:ShareRow Spacing="3" MinChild="12"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
              <Style Selector="ContentPresenter" x:DataType="vm:StorageViewModel+Segment">
                <Setter Property="c:ShareRow.Share" Value="{Binding Share}"/>
              </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StorageViewModel+Segment">
                <Button Classes="seg" Command="{Binding Pick}" Background="{Binding Fill}" Opacity="{Binding Strength}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left"
                        ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                  <TextBlock Text="{Binding Short}" Foreground="{Binding Ink}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
      <!-- what the page is doing, pinned for as long as it takes: deleting or removing (the bar fills as the drive's free space
           grows), then measuring again -->
      <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10"
              IsVisible="{Binding IsBusy}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <c:Spinner Width="18" Height="18" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding BusyText}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding BusyDetail}" FontSize="13" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
          </Grid>
          <!-- (the share freed while removing; a sweep while measuring, whose share done is not known) -->
          <c:Bar Value="{Binding BusyFraction}" Fill="{StaticResource Brand}" Indeterminate="{Binding SweepBusy}"/>
        </StackPanel>
      </Border>
      <Border Classes="divider" Margin="0,2,0,0"/>
    </StackPanel>

    <Grid ColumnDefinitions="*,280" ColumnSpacing="20" Margin="0,16,0,0">
      <!-- the group shown: the only part that scrolls -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,4">
        <Border Classes="card" Padding="20,18" VerticalAlignment="Top">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Width="14" Height="14" CornerRadius="4" Background="{Binding GroupFill}" VerticalAlignment="Center"/>
              <!-- (one text: the group's name and its size on one baseline) -->
              <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding GroupName}" FontSize="20" FontWeight="Bold"/>
                <Run Text="  " FontSize="20"/>
                <Run Text="{Binding GroupSize}" FontSize="16" Foreground="{StaticResource InkSoft}"/>
              </TextBlock>
              <!-- (off while what holds them runs: its tip says why, shown on the disabled button too) -->
              <Button Grid.Column="2" Classes="small" Content="{Binding ClearAllText}" Command="{Binding AskAllCommand}" IsVisible="{Binding ShowClearAll}"
                      ToolTip.Tip="{Binding ClearAllTip}" ToolTip.ShowOnDisabled="True" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding GroupAbout}" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
            <Border Classes="badbox" Margin="0" IsVisible="{Binding ConfirmingAll}">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding ConfirmAllText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="bad" Content="{c:T 'Remove'}" Command="{Binding RemoveAllCommand}"/>
                <Button Grid.Column="2" Content="{c:T 'Cancel'}" Command="{Binding CancelCommand}"/>
              </Grid>
            </Border>
            <StackPanel Spacing="4" IsVisible="{Binding IsFasterUpdates}">
              <CheckBox Classes="tick" Content="{Binding KeepText}" IsChecked="{Binding KeepBuildFiles}"/>
              <TextBlock FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="28,0,0,0" Text="{Binding KeepHint}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StorageViewModel+Row">
                  <Border Background="{StaticResource Page}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding About}" FontSize="13" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" CornerRadius="999" Padding="10,4" Background="{Binding TagFill}" IsVisible="{Binding HasTag}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Tag}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TagInk}"/>
                        </Border>
                        <Button Grid.Column="3" Classes="small" Content="{c:T 'Remove'}" Command="{Binding Ask}" IsVisible="{Binding ShowRemove}"
                                IsEnabled="{Binding CanRemove}" ToolTip.Tip="{Binding RemoveTip}" ToolTip.ShowOnDisabled="True"
                                AutomationProperties.Name="{Binding RemoveName}" VerticalAlignment="Center"/>
                      </Grid>
                      <Border Classes="badbox" Margin="0" IsVisible="{Binding Confirming}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                          <TextBlock Text="{Binding ConfirmText}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Classes="bad" Content="{c:T 'Remove'}" Command="{Binding Remove}"/>
                          <Button Grid.Column="2" Content="{c:T 'Cancel'}" Command="{Binding Cancel}"/>
                        </Grid>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding GroupNote}" IsVisible="{Binding HasGroupNote}" FontSize="13" Foreground="{StaticResource InkFaintText}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- pinned beside it: where it all goes -->
      <StackPanel Grid.Column="1" Spacing="14">
        <Border Classes="card" Padding="16,14">
          <StackPanel Spacing="6">
            <TextBlock Text="{c:T 'Where it goes'}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Classes="faint" Text="{c:T 'Builds folder'}"/>
            <TextBox Classes="path" Text="{Binding BuildsFolder, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{c:T 'Builds folder'}"/>
            <TextBlock Classes="faint" Text="{c:T 'Build files'}" Margin="0,6,0,0"/>
            <TextBox Classes="path" Text="{Binding Work, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="{c:T 'Build files'}"/>
            <Border Classes="warnbox" IsVisible="{Binding WorkElsewhere}" Margin="0,6,0,0">
              <TextBlock Text="{Binding WorkElsewhereText}" FontSize="13" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </Border>
        <!-- everything Longshot put on this PC, in one go: asked first, with what goes and what stays, the saves kept unless
             ticked (RemoveEverythingViewModel) -->
        <Border Classes="card" Padding="16,12">
          <StackPanel Spacing="8">
            <TextBlock Text="{c:T 'Remove Longshot from this PC'}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Button Classes="bad" HorizontalAlignment="Left" Content="{c:T 'Remove everything…'}" Command="{Binding RemoveEverythingCommand}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding BusyNote}" FontSize="12" Foreground="{StaticResource InkFaintText}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
