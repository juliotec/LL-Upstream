<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Styles>
    <Style Selector="Border.vrow.selected">
      <Setter Property="Background" Value="{StaticResource Selected}"/>
    </Style>
    <Style Selector="Button.savescard">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="12,10,14,10"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Border.vrow:pointerover">
      <Setter Property="Background" Value="{StaticResource RowHover}"/>
    </Style>
    <Style Selector="Border.vrow.selected:pointerover">
      <Setter Property="Background" Value="{StaticResource Selected}"/>
    </Style>
    <!-- a banner's Details: a link that shows the whole text, Less again -->
    <Style Selector="ToggleButton.details">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="ToggleButton.details /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="ToggleButton.details:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.details:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="ToggleButton.details:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- the launcher's channel offers another launcher: a newer one, or after a channel switch maybe an older one (SelfUpdate) -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasLauncherUpdate}" Margin="0,0,0,6" Padding="16,12,14,12" CornerRadius="10"
            BorderBrush="#4D5FB08A" BorderThickness="1">
      <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14">
        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GoSoft}" VerticalAlignment="Center">
          <c:Icon Kind="arrowUp" Width="16" Height="16" Foreground="{StaticResource Go}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding LauncherUpdateHeading}" FontWeight="SemiBold"/>
          <!-- one line; Details shows the whole text (a tooltip alone would not reach a touch screen: the Steam Deck) -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Classes="note" Text="{Binding LauncherUpdateText}" MaxLines="1" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !#LauncherMore.IsChecked}" ToolTip.Tip="{Binding LauncherUpdateText}"/>
            <TextBlock Classes="note" Text="{Binding LauncherUpdateText}" TextWrapping="Wrap" IsVisible="{Binding #LauncherMore.IsChecked}"/>
            <ToggleButton Grid.Column="1" x:Name="LauncherMore" Classes="details">
              <Panel>
                <TextBlock Text="{c:T 'Details'}" IsVisible="{Binding !#LauncherMore.IsChecked}"/>
                <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #LauncherMore.IsChecked}"/>
              </Panel>
            </ToggleButton>
          </Grid>
          <!-- while it updates: each step, the download's percentage and bar, and Cancel while it downloads -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0" IsVisible="{Binding UpdateLauncherCommand.IsBusy}">
            <TextBlock Classes="note tnum" Foreground="{StaticResource InfoInk}" Text="{Binding UpdateLauncherCommand.Status}" VerticalAlignment="Center"/>
            <Button Classes="link smaller" Content="{c:T 'Cancel'}" Command="{Binding CancelLauncherUpdateCommand}"
                    IsVisible="{Binding UpdateLauncherCommand.CanCancel}" VerticalAlignment="Center"/>
          </StackPanel>
          <c:Bar Height="4" Margin="0,6,0,2" Fill="{StaticResource Brand}"
                 Value="{Binding UpdateLauncherCommand.Progress}" IsVisible="{Binding UpdateLauncherCommand.HasFraction}"/>
        </StackPanel>
        <!-- What's new in it (ReleaseNotesViewModel), then the update -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link" Content="{c:T 'What\'s new'}" Command="{Binding LauncherNotesCommand}"/>
          <Button Classes="small" Command="{Binding UpdateLauncherCommand}">
            <c:BusyContent Content="{Binding LauncherUpdateButton}" IsBusy="{Binding UpdateLauncherCommand.IsBusy}" BusyText="{c:T 'Updating…'}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <!-- Hookshot's saves found, offered once -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasHookshotOffer}" Margin="0,0,0,6" Padding="16,12,14,12" CornerRadius="10"
            BorderBrush="#4D5FB08A" BorderThickness="1">
      <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14">
        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GoSoft}" VerticalAlignment="Center">
          <c:Icon Kind="disk" Width="16" Height="16" Foreground="{StaticResource Go}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{c:T 'Your Hookshot saves'}" FontWeight="SemiBold"/>
          <!-- one line; Details shows the whole text (a tooltip alone would not reach a touch screen: the Steam Deck) -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Classes="note" Text="{Binding HookshotOffer}" MaxLines="1" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !#HookshotMore.IsChecked}" ToolTip.Tip="{Binding HookshotOffer}"/>
            <TextBlock Classes="note" Text="{Binding HookshotOffer}" TextWrapping="Wrap" IsVisible="{Binding #HookshotMore.IsChecked}"/>
            <ToggleButton Grid.Column="1" x:Name="HookshotMore" Classes="details">
              <Panel>
                <TextBlock Text="{c:T 'Details'}" IsVisible="{Binding !#HookshotMore.IsChecked}"/>
                <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #HookshotMore.IsChecked}"/>
              </Panel>
            </ToggleButton>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="small" Content="{c:T 'Not now'}" Command="{Binding NotNowHookshotCommand}"/>
          <Button Classes="small" Content="{c:T 'Import…'}" Command="{Binding ImportHookshotCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- NX2navi's saves found, offered once -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasNx2naviOffer}" Margin="0,0,0,6" Padding="16,12,14,12" CornerRadius="10"
            BorderBrush="#4D5FB08A" BorderThickness="1">
      <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14">
        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GoSoft}" VerticalAlignment="Center">
          <c:Icon Kind="disk" Width="16" Height="16" Foreground="{StaticResource Go}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{c:T 'Your NX2navi saves'}" FontWeight="SemiBold"/>
          <!-- one line; Details shows the whole text (a tooltip alone would not reach a touch screen: the Steam Deck) -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Classes="note" Text="{Binding Nx2naviOffer}" MaxLines="1" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !#Nx2naviMore.IsChecked}" ToolTip.Tip="{Binding Nx2naviOffer}"/>
            <TextBlock Classes="note" Text="{Binding Nx2naviOffer}" TextWrapping="Wrap" IsVisible="{Binding #Nx2naviMore.IsChecked}"/>
            <ToggleButton Grid.Column="1" x:Name="Nx2naviMore" Classes="details">
              <Panel>
                <TextBlock Text="{c:T 'Details'}" IsVisible="{Binding !#Nx2naviMore.IsChecked}"/>
                <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #Nx2naviMore.IsChecked}"/>
              </Panel>
            </ToggleButton>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="small" Content="{c:T 'Not now'}" Command="{Binding NotNowNx2naviCommand}"/>
          <Button Classes="small" Content="{c:T 'Import…'}" Command="{Binding ImportNx2naviCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- a portable launcher with no build yet: the installed launcher's builds and saves on this PC, offered once -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasInstalledOffer}" Margin="0,0,0,6" Padding="16,12,14,12" CornerRadius="10"
            BorderBrush="#4D5FB08A" BorderThickness="1">
      <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14">
        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GoSoft}" VerticalAlignment="Center">
          <c:Icon Kind="folder" Width="16" Height="16" Foreground="{StaticResource Go}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{c:T 'Your installed launcher\'s builds and saves'}" FontWeight="SemiBold"/>
          <!-- one line; Details shows the whole text (a tooltip alone would not reach a touch screen: the Steam Deck) -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Classes="note" Text="{Binding InstalledOffer}" MaxLines="1" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !#InstalledMore.IsChecked}" ToolTip.Tip="{Binding InstalledOffer}"/>
            <TextBlock Classes="note" Text="{Binding InstalledOffer}" TextWrapping="Wrap" IsVisible="{Binding #InstalledMore.IsChecked}"/>
            <ToggleButton Grid.Column="1" x:Name="InstalledMore" Classes="details">
              <Panel>
                <TextBlock Text="{c:T 'Details'}" IsVisible="{Binding !#InstalledMore.IsChecked}"/>
                <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #InstalledMore.IsChecked}"/>
              </Panel>
            </ToggleButton>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="small" Content="{c:T 'Not now'}" Command="{Binding NotNowInstalledCommand}"/>
          <Button Classes="small" Content="{c:T 'Use them'}" Command="{Binding UseInstalledCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- old versions' folders updates left on the disk: Keep or Delete -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasLeftoverOffer}" Margin="0,0,0,6" Padding="16,12,14,12" CornerRadius="10"
            BorderBrush="#4D5FB08A" BorderThickness="1">
      <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14">
        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GoSoft}" VerticalAlignment="Center">
          <c:Icon Kind="trash" Width="16" Height="16" Foreground="{StaticResource Go}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{c:T 'Old versions left on the disk'}" FontWeight="SemiBold"/>
          <!-- one line; Details shows the whole text (a tooltip alone would not reach a touch screen: the Steam Deck) -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Classes="note" Text="{Binding LeftoverOffer}" MaxLines="1" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !#LeftoverMore.IsChecked}" ToolTip.Tip="{Binding LeftoverOffer}"/>
            <TextBlock Classes="note" Text="{Binding LeftoverOffer}" TextWrapping="Wrap" IsVisible="{Binding #LeftoverMore.IsChecked}"/>
            <ToggleButton Grid.Column="1" x:Name="LeftoverMore" Classes="details">
              <Panel>
                <TextBlock Text="{c:T 'Details'}" IsVisible="{Binding !#LeftoverMore.IsChecked}"/>
                <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #LeftoverMore.IsChecked}"/>
              </Panel>
            </ToggleButton>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="small" Content="{c:T 'Keep'}" Command="{Binding KeepLeftoversCommand}"/>
          <Button Classes="small" Content="{c:T 'Delete'}" Command="{Binding DeleteLeftoversCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- instances' folders from before builds/<track>/<version>: Keep or Move (InstanceFolders) -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasRenameOffer}" Margin="0,0,0,6" Padding="16,12,14,12" CornerRadius="10"
            BorderBrush="#4D5FB08A" BorderThickness="1">
      <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="14">
        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource GoSoft}" VerticalAlignment="Center">
          <c:Icon Kind="folder" Width="16" Height="16" Foreground="{StaticResource Go}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{c:T 'Instances in the old folder layout'}" FontWeight="SemiBold"/>
          <!-- one line; Details shows the whole text (a tooltip alone would not reach a touch screen: the Steam Deck) -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Classes="note" Text="{Binding RenameSummary}" MaxLines="1" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !#RenameMore.IsChecked}" ToolTip.Tip="{Binding RenameOffer}"/>
            <TextBlock Classes="note" Text="{Binding RenameOffer}" TextWrapping="Wrap" IsVisible="{Binding #RenameMore.IsChecked}"/>
            <ToggleButton Grid.Column="1" x:Name="RenameMore" Classes="details">
              <Panel>
                <TextBlock Text="{c:T 'Details'}" IsVisible="{Binding !#RenameMore.IsChecked}"/>
                <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #RenameMore.IsChecked}"/>
              </Panel>
            </ToggleButton>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="small" Content="{c:T 'Keep'}" Command="{Binding KeepNamesCommand}"/>
          <Button Classes="small" Content="{c:T 'Move'}" Command="{Binding RenameFoldersCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- a problem to read -->
    <Border DockPanel.Dock="Top" Classes="warnbox" IsVisible="{Binding HasNotice}" Margin="0,0,0,6">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <c:Icon Kind="alert" Foreground="{StaticResource Warn}" VerticalAlignment="Top"/>
        <StackPanel Grid.Column="1">
            <!-- one line; Details shows the whole text (a tooltip alone would not reach a touch screen: the Steam Deck) -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Classes="" Text="{Binding Notice}" MaxLines="1" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !#NoticeMore.IsChecked}" ToolTip.Tip="{Binding Notice}"/>
              <TextBlock Classes="" Text="{Binding Notice}" TextWrapping="Wrap" IsVisible="{Binding #NoticeMore.IsChecked}"/>
              <ToggleButton Grid.Column="1" x:Name="NoticeMore" Classes="details">
                <Panel>
                  <TextBlock Text="{c:T 'Details'}" IsVisible="{Binding !#NoticeMore.IsChecked}"/>
                  <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #NoticeMore.IsChecked}"/>
                </Panel>
              </ToggleButton>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
          <Button Classes="link soft" Content="{c:T 'Copy for a bug report'}" Command="{Binding CopyNoticeReportCommand}"/>
          <Button Classes="link soft" Content="{c:T 'Dismiss'}" Command="{Binding DismissProblemCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- (the scroll bar is drawn over the content's right edge, Fluent's ScrollViewer: the content keeps a gutter for it) -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Panel Margin="0,0,16,0">
      <!-- no build yet: Build -->
      <StackPanel IsVisible="{Binding NoBuilds}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Panel Width="190" Height="190" HorizontalAlignment="Center">
          <Ellipse Margin="8">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#663D63E6"/>
                <GradientStop Offset="0.68" Color="#003D63E6"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Image Source="avares://LongshotLauncher/Assets/longshot.png" Width="132" Height="132" RenderOptions.BitmapInterpolationMode="HighQuality">
            <Image.Effect><DropShadowEffect OffsetX="0" OffsetY="12" BlurRadius="14" Color="#99000000"/></Image.Effect>
          </Image>
        </Panel>
        <TextBlock Classes="heading" Text="{c:T 'Build your game'}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        <TextBlock Classes="sub" MaxWidth="470" TextAlignment="Center" HorizontalAlignment="Center"
                   Text="{c:T 'Longshot makes a PC version of your own copy of the game. It takes about 15 to 30 minutes, once per version.'}"/>
        <Button Classes="primary tall" HorizontalAlignment="Center" Margin="0,26,0,0" MinWidth="190" FontSize="16" Command="{Binding BuildCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:Icon Kind="download" Width="16" Height="16"/>
            <TextBlock Text="{c:T 'Build'}"/>
          </StackPanel>
        </Button>
        <!-- the NFC tags do not wait for a build: every version shares them, a game built elsewhere reads them too -->
        <Button Classes="link" HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding NfcCommand}"
                ToolTip.Tip="Add and delete the NFC tag dumps the game's NFC tab lists">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="nfc" Width="14" Height="14"/>
            <TextBlock Text="NFC tags"/>
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,16,0,0" IsVisible="{Binding KnowsNewest}">
          <TextBlock Classes="note" Text="{c:T 'Builds'}" VerticalAlignment="Center"/>
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding NewestDefaultText}" VerticalAlignment="Center"/>
          <Border Classes="tag" Classes.rc="{Binding DefaultIsCandidate}" Classes.nightly="{Binding DefaultIsNightly}">
            <TextBlock Text="{Binding DefaultChannel}"/>
          </Border>
          <Button Classes="link" Content="{c:T 'Change'}" Command="{Binding ChannelCommand}" Margin="4,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,16,0,0" IsVisible="{Binding Checking}">
          <c:Spinner VerticalAlignment="Center"/>
          <TextBlock Classes="note" Text="{c:T 'Asking git.magicbean.dev for the newest version…'}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding ShowCheckLine}">
          <c:Spinner VerticalAlignment="Center"/>
          <TextBlock Classes="note" Text="{Binding CheckCommand.Status}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,16,0,0" IsVisible="{Binding CheckFailed}">
          <TextBlock Classes="note" Text="{Binding CheckFailedText}"/>
          <Button Classes="link" Content="{c:T 'Change'}" Command="{Binding ChannelCommand}" IsVisible="{Binding ChannelEmpty}"/>
          <Button Classes="link" Content="{c:T 'Try again'}" Command="{Binding RetryCheckCommand}"/>
          <Button Classes="link soft" Content="{c:T 'Copy for a bug report'}" Command="{Binding CopyCheckReportCommand}" IsVisible="{Binding ShowCheckReport}"/>
        </StackPanel>
        <!-- why: no address, no connection, a timeout, an HTTP error, or a release refused -->
        <TextBlock Classes="note" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,4,0,0"
                   Text="{Binding CheckWhy}" IsVisible="{Binding HasCheckWhy}"/>
        <TextBlock Classes="faint" HorizontalAlignment="Center" Margin="0,8,0,0"
                   Text="{c:T 'You need your dump of the game: a .nup or .nx file, or its romfs and exefs folders.'}"/>
        <!-- built already, by another launcher (installed or portable) or in a folder moved since: listed where it is -->
        <Button Classes="link" HorizontalAlignment="Center" Margin="0,10,0,0" Command="{Binding AddFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="folder" Width="14" Height="14"/>
            <TextBlock Text="{c:T 'Built it already? Add its folder…'}"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- the default version, and every version -->
      <!-- (centred as a whole when it fits, from the top when it does not; the title on a row of its own, so the two columns start
           level: TRACK beside YOUR INSTANCES) -->
      <Grid IsVisible="{Binding HasBuilds}" ColumnDefinitions="300,*" RowDefinitions="Auto,Auto" ColumnSpacing="44"
            VerticalAlignment="Center">
        <TextBlock Classes="title" Text="Longshot"/>
        <!-- opposite the title: the picked track's newest version when its build has an update, and What's new in it
             (ReleaseNotesViewModel: every version since the build's, newest first); nothing there otherwise -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,8,0,0"
                    IsVisible="{Binding HasTrackUpdate}">
          <c:Icon Kind="arrowUp" Width="15" Height="15" Foreground="{StaticResource BrandInk}" VerticalAlignment="Center"/>
          <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandInk}" Text="{Binding TrackUpdate}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          <Button Classes="link" Content="{c:T 'What\'s new'}" Command="{Binding NotesDefaultCommand}" VerticalAlignment="Center"
                  IsVisible="{Binding !TrackUpdateIsPullRequest}"/>
          <!-- (a pull request's newer push has no release notes: the pull request itself) -->
          <Button Classes="link" Content="{c:T 'Read it'}" Command="{Binding ReadPullRequestCommand}" VerticalAlignment="Center"
                  IsVisible="{Binding TrackUpdateIsPullRequest}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Top">
          <!-- the track (its name only: what it holds is the Version field's), then one of its versions (VersionPick): a check
               beside the installed one, Update available beside it when its build has a newer version, the button below -->
          <TextBlock Classes="label" Text="{c:T 'TRACK'}" Margin="0,12,0,6"/>
          <ComboBox Width="NaN" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding Tracks}" SelectedItem="{Binding PickTrack}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TrackChoice">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- (the field's badge on its label's row, so the version itself is never cut; the list has room for it on the row) -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,6">
            <TextBlock Classes="label" Text="{c:T 'VERSION'}" Margin="0" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Classes="chip small update" IsVisible="{Binding PickHasUpdate}">
              <TextBlock Text="{c:T 'Update available'}"/>
            </Border>
          </Grid>
          <ComboBox Width="NaN" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding TrackVersions}" SelectedItem="{Binding PickVersion}" IsEnabled="{Binding HasTrackVersions}">
            <ComboBox.SelectionBoxItemTemplate>
              <DataTemplate x:DataType="vm:VersionChoice">
                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                  <c:Icon Kind="check" Width="14" Height="14" Foreground="{StaticResource Go}" VerticalAlignment="Center"
                          IsVisible="{Binding Installed}" ToolTip.Tip="{c:T 'Installed'}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Shown}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Classes="faint" Text="{Binding Note}" VerticalAlignment="Center" IsVisible="{Binding !HasUpdate}"/>
                </Grid>
              </DataTemplate>
            </ComboBox.SelectionBoxItemTemplate>
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VersionChoice">
                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                  <c:Icon Kind="check" Width="14" Height="14" Foreground="{StaticResource Go}" VerticalAlignment="Center"
                          IsVisible="{Binding Installed}" ToolTip.Tip="{c:T 'Installed'}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Shown}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Classes="faint" Text="{Binding Note}" VerticalAlignment="Center" IsVisible="{Binding !HasUpdate}"/>
                  <Border Grid.Column="2" Classes="chip small update" IsVisible="{Binding HasUpdate}">
                    <TextBlock Text="{c:T 'Update available'}"/>
                  </Border>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- the Pull request track: who wrote the one picked and whether a BigBean approved it, Read it, and Find a pull request
               for one the list leaves out (it lists the ones a BigBean wrote or approved) -->
          <StackPanel IsVisible="{Binding IsPullRequestTrack}" Margin="0,8,0,0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPickedPullRequest}">
              <c:Icon Kind="check" Width="13" Height="13" Foreground="{StaticResource Go}" VerticalAlignment="Center" IsVisible="{Binding PullRequestTrusted}"/>
              <c:Icon Kind="alert" Width="13" Height="13" Foreground="{StaticResource Warn}" VerticalAlignment="Center" IsVisible="{Binding PullRequestUntrusted}"/>
              <TextBlock Classes="note" Text="{Binding PullRequestTrust}" TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <Button Classes="link smaller" Content="{c:T 'Read it'}" Command="{Binding ReadPullRequestCommand}" IsVisible="{Binding HasPickedPullRequest}"/>
              <Button Classes="link smaller" Content="{c:T 'Find a pull request…'}" Command="{Binding FindPullRequestCommand}"/>
            </StackPanel>
          </StackPanel>
          <!-- the pick's button: Play when it is installed, else Update to, Go back to or Build; Update beside Play, the same size
               and with its icon, when the build has a newer version (it takes the room left, its words cut rather than the row) -->
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,14,0,0">
            <Button Classes="go" Command="{Binding GoCommand}" IsVisible="{Binding GoIsPlay}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Kind="play" Width="18" Height="18"/>
                <TextBlock Text="{c:T 'Play'}"/>
              </StackPanel>
            </Button>
            <Button Classes="primary tall" Command="{Binding GoCommand}" IsVisible="{Binding GoIsBuild}">
              <TextBlock Text="{Binding GoText}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
            </Button>
            <Button Grid.Column="1" Classes="primary tall hero" HorizontalAlignment="Left" Command="{Binding UpdateDefaultCommand}"
                    IsVisible="{Binding HeroHasUpdate}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Kind="arrowUp" Width="18" Height="18"/>
                <TextBlock Text="{c:T 'Update'}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Button>
          </Grid>
          <!-- what it does: the installed version's line, the build a version replaces in its folder, or a new build's -->
          <TextBlock Classes="note" Text="{Binding HeroNote}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <!-- Remove: the row's Delete -->
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
            <Button Classes="link smaller" Command="{Binding RemoveCommand}" IsVisible="{Binding ShowRemove}" Foreground="{StaticResource Bad}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="trash" Width="13" Height="13"/>
                <TextBlock Text="{c:T 'Remove'}"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <!-- the saves: a button the size of a card, so copying, importing and exporting saves is easy to find -->
          <Button Classes="savescard" Command="{Binding SavesDefaultCommand}" Margin="0,12,0,0" ToolTip.Tip="{c:T 'Your saves, which every version shares: import them, export them'}">
            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
              <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource GoSoft}" VerticalAlignment="Center">
                <c:Icon Kind="disk" Width="16" Height="16" Foreground="{StaticResource Go}"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{c:T 'Manage saves'}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Classes="note" Text="{Binding HeroSaves}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <c:Icon Grid.Column="2" Kind="chevronRight" Width="16" Height="16" Foreground="{StaticResource InkFaintText}" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <!-- the NFC tags every version shares: a card as the saves' -->
          <Button Classes="savescard" Command="{Binding NfcCommand}" Margin="0,8,0,0" ToolTip.Tip="Add and delete the NFC tag dumps the game's NFC tab lists">
            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="12">
              <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrandSoft}" VerticalAlignment="Center">
                <c:Icon Kind="nfc" Width="16" Height="16" Foreground="{StaticResource BrandInk}"/>
              </Border>
              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="NFC" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Classes="note" Text="Your NFC tags, for the game's NFC tab" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <c:Icon Grid.Column="2" Kind="chevronRight" Width="16" Height="16" Foreground="{StaticResource InkFaintText}" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Classes="label" Text="{c:T 'YOUR INSTANCES'}" Margin="0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
              <Button Classes="link" Command="{Binding AddFolderCommand}" ToolTip.Tip="{c:T 'A game folder, a folder of them, or a portable launcher\'s LongshotLauncher-data: listed where it is'}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="folder" Width="14" Height="14"/>
                  <TextBlock Text="{c:T 'Add a build folder…'}"/>
                </StackPanel>
              </Button>
              <Button Classes="link" Command="{Binding ChannelCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="plus" Width="14" Height="14"/>
                  <TextBlock Text="{c:T 'Build another version'}"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Classes="card">
            <ScrollViewer MaxHeight="370" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Builds}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BuildItemViewModel">
                    <Border Classes="vrow" Classes.selected="{Binding IsSelected}" Background="Transparent"
                            BorderBrush="{StaticResource GlassLine}" BorderThickness="{Binding Separator}">
                      <Panel>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0" Background="{StaticResource Brand}"
                                IsVisible="{Binding IsSelected}"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                          <Button Classes="row" Command="{Binding SelectCommand}" Background="Transparent">
                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="14" Margin="16,13">
                              <Panel VerticalAlignment="Center">
                                <c:Icon Kind="star" Width="17" Height="17" Foreground="{StaticResource Warn}" IsVisible="{Binding IsDefault}"/>
                                <Ellipse Width="14" Height="14" Stroke="{StaticResource InkFaint}" StrokeThickness="1.5" IsVisible="{Binding ShowRing}"/>
                              </Panel>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Classes="faint" Text="{Binding Meta}" IsVisible="{Binding ShowMeta}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDeleting}">
                                  <c:Spinner Width="12" Height="12" VerticalAlignment="Center"/>
                                  <TextBlock Classes="faint" Text="{Binding DeletingText}"/>
                                </StackPanel>
                              </StackPanel>
                              <!-- (an update: only the badge here; the hero's Update and What's new act on it once the row is picked) -->
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Classes="chip small update" IsVisible="{Binding ShowUpdateBadge}"><TextBlock Text="{c:T 'Update available'}"/></Border>
                                <Border Classes="chip quiet" IsVisible="{Binding IsDefault}"><TextBlock Text="{c:T 'Default'}"/></Border>
                                <Border Classes="tag" Classes.rc="{Binding IsCandidate}" Classes.nightly="{Binding IsNightly}" Classes.pr="{Binding IsPullRequest}">
                                  <TextBlock Text="{Binding Channel}"/>
                                </Border>
                              </StackPanel>
                            </Grid>
                          </Button>
                          <!-- (the left side wraps, so the buttons on the right always show whole in the 1040-wide window) -->
                          <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="50,0,12,12" IsVisible="{Binding ShowActions}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding ShowDefaultNote}" Margin="4,0,0,0" VerticalAlignment="Center">
                              <c:Icon Kind="star" Width="13" Height="13" Foreground="{StaticResource Warn}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Classes="faint" Text="{c:T 'Your default: the Play button starts this one'}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                            <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding ShowOtherActions}" VerticalAlignment="Center">
                              <Button Classes="small" Command="{Binding PlayCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <c:Icon Kind="play" Width="14" Height="14"/>
                                  <TextBlock Text="{c:T 'Play this version'}"/>
                                </StackPanel>
                              </Button>
                              <Button Classes="small" Command="{Binding SetDefaultCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <c:Icon Kind="starLine" Width="14" Height="14"/>
                                  <TextBlock Text="{c:T 'Set as default'}"/>
                                </StackPanel>
                              </Button>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <Button Classes="small" Command="{Binding SavesCommand}" ToolTip.Tip="{c:T 'Import or export your saves, which every version shares'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <c:Icon Kind="disk" Width="14" Height="14"/>
                                  <TextBlock Text="{c:T 'Saves'}"/>
                                </StackPanel>
                              </Button>
                              <Button Classes="icon" Command="{Binding FolderCommand}" ToolTip.Tip="{c:T 'Open folder'}"><c:Icon Kind="folder"/></Button>
                              <Button Classes="icon iconbad" Command="{Binding DeleteCommand}" ToolTip.Tip="{c:T 'Delete'}"><c:Icon Kind="trash"/></Button>
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <!-- the footer, and Check for updates: Longshot's channels and the launcher's own, now -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,16,0,0">
            <TextBlock Classes="faint" Text="{Binding Footer}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="link smaller" Command="{Binding CheckForUpdatesCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="{c:T 'Look for a new Longshot on your versions\' channels, and a new launcher'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Kind="refresh" Width="13" Height="13"/>
                <TextBlock Text="{c:T 'Check for updates'}"/>
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Classes="faint" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding ShowStatus}"/>
          <Button Classes="link soft" HorizontalAlignment="Left" Margin="0,2,0,0" Content="{c:T 'Copy for a bug report'}"
                  Command="{Binding CopyCheckReportCommand}" IsVisible="{Binding ShowStatusReport}"/>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding CheckCommand.IsBusy}">
            <c:Spinner Width="12" Height="12" VerticalAlignment="Center"/>
            <TextBlock Classes="faint" Text="{Binding CheckCommand.Status}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Panel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
