<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             xmlns:core="using:LongshotLauncher.Core"
             xmlns:views="using:LongshotLauncher.Views"
             x:Class="LongshotLauncher.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Styles>
    <!-- the front page's group: centred, one width for the band, the pickers and the button -->
    <Style Selector="StackPanel.front">
      <Setter Property="Width" Value="680"/>
      <Setter Property="Spacing" Value="26"/>
    </Style>
    <Style Selector="Grid.bandgrid">
      <Setter Property="Margin" Value="34,20,30,20"/>
    </Style>
    <Style Selector="Image.bandlogo">
      <Setter Property="Width" Value="120"/>
      <Setter Property="Height" Value="120"/>
    </Style>
    <Style Selector="StackPanel.gorow">
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style Selector="StackPanel.gorow Button.bigplay">
      <Setter Property="MinWidth" Value="240"/>
    </Style>
    <!-- (the Save picker with no version yet: off, as quiet as the page, not the theme's light grey) -->
    <Style Selector="ComboBox.picker:disabled">
      <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="ComboBox.picker:disabled /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
    </Style>
    <!-- Update beside Play: as big, a strong second (light on the dark page), never green -->
    <Style Selector="Button.second.bigplay">
      <Setter Property="Background" Value="#26FFFFFF"/>
      <Setter Property="BorderBrush" Value="#40FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.second.bigplay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#38FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="TextBlock.note.warn">
      <Setter Property="Foreground" Value="{StaticResource Warn}"/>
    </Style>
    <!-- a short window (960x560, a laptop's): the band and the spacing smaller, so the button stays in view -->
    <ContainerQuery Name="home" Query="max-height:560">
      <Style Selector="StackPanel.front">
        <Setter Property="Spacing" Value="16"/>
      </Style>
      <Style Selector="Grid.bandgrid">
        <Setter Property="Margin" Value="28,10,24,10"/>
      </Style>
      <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="48"/>
      </Style>
      <Style Selector="Image.bandlogo">
        <Setter Property="Width" Value="96"/>
        <Setter Property="Height" Value="96"/>
      </Style>
      <Style Selector="Button.bigplay">
        <Setter Property="Height" Value="54"/>
      </Style>
    </ContainerQuery>
    <Style Selector="Button.savescard">
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="Padding" Value="16,16,18,16"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <!-- the cards over the versions (an offer, an update, a problem): a soft brand-blue card, its icon in a circle, a title, the
         whole text (no one-line cut: its first sentence bright, the rest on a quieter line, Converters.FirstSentence), a quiet link for the second choice and one strong button; a problem in the warning's colour -->
    <Style Selector="Border.offer">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="18,14,16,14"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="BorderBrush" Value="#553D63E6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.offericon">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Background" Value="#403D63E6"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.offer.warn">
      <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
      <Setter Property="BorderBrush" Value="#55E2B86B"/>
    </Style>
    <Style Selector="Border.offer.warn Border.offericon">
      <Setter Property="Background" Value="#33E2B86B"/>
    </Style>
    <Style Selector="TextBlock.offertitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.offerfine">
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <!-- a banner's Details: a link that shows the whole text, Less again -->
    <Style Selector="ToggleButton.details">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="NaN"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="ToggleButton.details /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="ToggleButton.details:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.details:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="ToggleButton.details:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </UserControl.Styles>
  <DockPanel Container.Name="home" Container.Sizing="Height">
    <!-- the launcher's channel offers another launcher: a newer one, or after a channel switch maybe an older one (SelfUpdate) -->
    <Border DockPanel.Dock="Top" Classes="offer" IsVisible="{Binding HasLauncherUpdate}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="arrowUp" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="offertitle" Text="{Binding LauncherUpdateHeading}"/>
          <TextBlock Classes="note" Text="{Binding LauncherUpdateText, Converter={x:Static c:Converters.FirstSentence}}" TextWrapping="Wrap"/>
          <TextBlock Classes="note offerfine" Text="{Binding LauncherUpdateText, Converter={x:Static c:Converters.AfterFirstSentence}}" TextWrapping="Wrap"
                     IsVisible="{Binding LauncherUpdateText, Converter={x:Static c:Converters.HasSecondSentence}}"/>
          <!-- while it updates: each step, the download's percentage and bar, and Cancel while it downloads -->
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0" IsVisible="{Binding UpdateLauncherCommand.IsBusy}">
            <TextBlock Classes="note tnum" Foreground="{StaticResource InfoInk}" Text="{Binding UpdateLauncherCommand.Status}" VerticalAlignment="Center"/>
            <Button Classes="link smaller" Content="{c:T 'Cancel'}" Command="{Binding CancelLauncherUpdateCommand}"
                    IsVisible="{Binding UpdateLauncherCommand.CanCancel}" VerticalAlignment="Center"/>
          </StackPanel>
          <c:Bar Height="4" Margin="0,6,0,2" Fill="{StaticResource Brand}"
                 Value="{Binding UpdateLauncherCommand.Progress}" IsVisible="{Binding UpdateLauncherCommand.HasFraction}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <!-- What's new in it (ReleaseNotesViewModel), then the update -->
          <Button Classes="link soft" Content="{c:T 'What\'s new'}" Command="{Binding LauncherNotesCommand}"/>
          <Button Classes="small primary" Command="{Binding UpdateLauncherCommand}">
            <c:BusyContent Content="{Binding LauncherUpdateButton}" IsBusy="{Binding UpdateLauncherCommand.IsBusy}" BusyText="{c:T 'Updating…'}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <!-- (Windows) NVIDIA's shader cache under 4 GB, which only an administrator can raise: offered once a launcher start. The
         whole text shows (what is wrong, then a quieter note; no Details), the raise is the card's one strong button -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasNvidiaCacheOffer}" Margin="0,0,0,8" Padding="18,14,16,14" CornerRadius="12"
            Background="{StaticResource BrandSoft}" BorderBrush="#553D63E6" BorderThickness="1">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Width="36" Height="36" CornerRadius="18" Background="#403D63E6" VerticalAlignment="Center">
          <c:Icon Kind="refresh" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{c:T 'Stop shaders compiling again at every start'}" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Classes="note" Text="{Binding NvidiaCacheOffer}" TextWrapping="Wrap"/>
          <TextBlock Classes="note" Text="{Binding NvidiaCacheNote}" TextWrapping="Wrap" Opacity="0.7"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Not now'}" Command="{Binding NotNowNvidiaCacheCommand}"/>
          <Button Classes="small primary" Command="{Binding RaiseNvidiaCacheCommand}">
            <c:BusyContent Content="{Binding NvidiaCacheButton}" IsBusy="{Binding RaisingNvidiaCache}" BusyText="{c:T 'Waiting for Windows…'}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Hookshot's saves found, offered once -->
    <Border DockPanel.Dock="Top" Classes="offer" IsVisible="{Binding HasHookshotOffer}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="disk" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="offertitle" Text="{c:T 'Your Hookshot saves'}"/>
          <TextBlock Classes="note" Text="{Binding HookshotOffer, Converter={x:Static c:Converters.FirstSentence}}" TextWrapping="Wrap"/>
          <TextBlock Classes="note offerfine" Text="{Binding HookshotOffer, Converter={x:Static c:Converters.AfterFirstSentence}}" TextWrapping="Wrap"
                     IsVisible="{Binding HookshotOffer, Converter={x:Static c:Converters.HasSecondSentence}}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Not now'}" Command="{Binding NotNowHookshotCommand}"/>
          <Button Classes="small primary" Content="{c:T 'Import…'}" Command="{Binding ImportHookshotCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- every version built by Longshot's old builder: a version to add again, or the stable launcher to play them -->
    <Border DockPanel.Dock="Top" Classes="offer" IsVisible="{Binding ShowOldOnly}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="plus" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="offertitle" Text="{c:T 'Add a version to play here'}"/>
          <TextBlock Classes="note" Text="{Binding OldOnlyText}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Not now'}" Command="{Binding OldOnlyNotNowCommand}"/>
          <Button Classes="link" Content="{c:T 'Stable launcher…'}" Command="{Binding OldOnlyStableCommand}"/>
          <Button Classes="small primary" Content="{c:T 'Add a version…'}" Command="{Binding OldOnlyAddCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- NX2navi's saves found, offered once -->
    <Border DockPanel.Dock="Top" Classes="offer" IsVisible="{Binding HasNx2naviOffer}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="disk" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="offertitle" Text="{c:T 'Your NX2navi saves'}"/>
          <TextBlock Classes="note" Text="{Binding Nx2naviOffer, Converter={x:Static c:Converters.FirstSentence}}" TextWrapping="Wrap"/>
          <TextBlock Classes="note offerfine" Text="{Binding Nx2naviOffer, Converter={x:Static c:Converters.AfterFirstSentence}}" TextWrapping="Wrap"
                     IsVisible="{Binding Nx2naviOffer, Converter={x:Static c:Converters.HasSecondSentence}}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Not now'}" Command="{Binding NotNowNx2naviCommand}"/>
          <Button Classes="small primary" Content="{c:T 'Import…'}" Command="{Binding ImportNx2naviCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- a portable launcher with no build yet: the installed launcher's builds and saves on this PC, offered once -->
    <Border DockPanel.Dock="Top" Classes="offer" IsVisible="{Binding HasInstalledOffer}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="folder" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="offertitle" Text="{c:T 'Your installed launcher\'s builds and saves'}"/>
          <TextBlock Classes="note" Text="{Binding InstalledOffer, Converter={x:Static c:Converters.FirstSentence}}" TextWrapping="Wrap"/>
          <TextBlock Classes="note offerfine" Text="{Binding InstalledOffer, Converter={x:Static c:Converters.AfterFirstSentence}}" TextWrapping="Wrap"
                     IsVisible="{Binding InstalledOffer, Converter={x:Static c:Converters.HasSecondSentence}}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Not now'}" Command="{Binding NotNowInstalledCommand}"/>
          <Button Classes="small primary" Content="{c:T 'Use them'}" Command="{Binding UseInstalledCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- old versions' folders updates left on the disk: Keep or Delete -->
    <Border DockPanel.Dock="Top" Classes="offer" IsVisible="{Binding HasLeftoverOffer}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="trash" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="offertitle" Text="{c:T 'Old versions left on the disk'}"/>
          <TextBlock Classes="note" Text="{Binding LeftoverOffer, Converter={x:Static c:Converters.FirstSentence}}" TextWrapping="Wrap"/>
          <TextBlock Classes="note offerfine" Text="{Binding LeftoverOffer, Converter={x:Static c:Converters.AfterFirstSentence}}" TextWrapping="Wrap"
                     IsVisible="{Binding LeftoverOffer, Converter={x:Static c:Converters.HasSecondSentence}}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Keep'}" Command="{Binding KeepLeftoversCommand}"/>
          <Button Classes="small primary" Content="{c:T 'Delete'}" Command="{Binding DeleteLeftoversCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- instances' folders from before builds/<track>/<version>: Keep or Move (InstanceFolders). The summary always; which
         folders as a list (RenameMoves, from → to) and the one caveat under Which folders -->
    <Border DockPanel.Dock="Top" Classes="offer" IsVisible="{Binding HasRenameOffer}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="folder" Width="18" Height="18" Foreground="{StaticResource InfoInk}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Classes="offertitle" Text="{c:T 'Versions in the old folder layout'}"/>
          <TextBlock Classes="note" Text="{Binding RenameSummary}" TextWrapping="Wrap"/>
          <StackPanel Spacing="2" Margin="0,4,0,2" IsVisible="{Binding #RenameMore.IsChecked}">
            <ItemsControl ItemsSource="{Binding RenameMoves}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Classes="note mono" Text="{Binding}"/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="note offerfine" Text="{Binding RenameCaveat}" TextWrapping="Wrap" Margin="0,4,0,0"/>
          </StackPanel>
          <ToggleButton x:Name="RenameMore" Classes="details" HorizontalAlignment="Left">
            <Panel>
              <TextBlock Text="{c:T 'Which folders'}" IsVisible="{Binding !#RenameMore.IsChecked}"/>
              <TextBlock Text="{c:T 'Less'}" IsVisible="{Binding #RenameMore.IsChecked}"/>
            </Panel>
          </ToggleButton>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Keep'}" Command="{Binding KeepNamesCommand}"/>
          <Button Classes="small primary" Content="{c:T 'Move'}" Command="{Binding RenameFoldersCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- a problem to read: the same card in the warning's colour, its whole text -->
    <Border DockPanel.Dock="Top" Classes="offer warn" IsVisible="{Binding HasNotice}">
      <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="14">
        <Border Classes="offericon">
          <c:Icon Kind="alert" Width="18" Height="18" Foreground="{StaticResource Warn}"/>
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Notice, Converter={x:Static c:Converters.FirstSentence}}" TextWrapping="Wrap"/>
          <TextBlock Classes="offerfine" Text="{Binding Notice, Converter={x:Static c:Converters.AfterFirstSentence}}" TextWrapping="Wrap"
                     IsVisible="{Binding Notice, Converter={x:Static c:Converters.HasSecondSentence}}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Button Classes="link soft" Content="{c:T 'Copy for a bug report'}" Command="{Binding CopyNoticeReportCommand}"/>
          <Button Classes="link soft" Content="{c:T 'Dismiss'}" Command="{Binding DismissProblemCommand}"/>
        </StackPanel>
      </Grid>
    </Border>


    <!-- ==== the profile's front page: the game's band, then the Version and Save pickers and the one button, centred; the
         profile is the title bar's. One page in every state: Build (no version, or its game gone), Update (Play beside it), Play ==== -->
    <Border Classes="homepage">
      <StackPanel Classes="front" VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- the band: the wordmark and the logo, a calm backdrop -->
        <Border Classes="heroband">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18" Classes="bandgrid">
            <TextBlock Classes="wordmark" Text="Longshot" VerticalAlignment="Center"/>
            <Image Grid.Column="1" Classes="tilted bandlogo" Source="avares://LongshotLauncher/Assets/longshot.png"
                   RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- the two pickers: the version (on this PC, then Manage versions… and New version…; with none yet, the one a build
             makes) and the save to start on (the profile's slots, the newest picked, then Manage saves…; New game with none;
             off with no version, hidden for a version that cannot start on a slot) -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Classes="pickers">
          <StackPanel>
            <TextBlock Classes="pickercap" Text="{c:T 'Version'}"/>
            <Panel>
              <!-- (the field shows the version's short name, never cut mid-name: the full one is the list's and the tooltip's) -->
              <ComboBox Classes="picker" ItemsSource="{Binding HeroChoices}" SelectedItem="{Binding HeroChoice}" AutomationProperties.Name="{c:T 'Version'}"
                        ToolTip.Tip="{Binding HeroItem.Version}" IsVisible="{Binding HasBuilds}">
                <ComboBox.SelectionBoxItemTemplate>
                  <DataTemplate x:DataType="vm:BuildItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="wrap lime" Text="{Binding ShortVersion}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="tag" Classes.nightly="{Binding IsNightly}" Classes.pr="{Binding IsPullRequest}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Channel}"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ComboBox.SelectionBoxItemTemplate>
                <ComboBox.DataTemplates>
                  <DataTemplate DataType="vm:BuildItemViewModel" x:DataType="vm:BuildItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="wrap" Text="{Binding Version}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="tag" Classes.nightly="{Binding IsNightly}" Classes.pr="{Binding IsPullRequest}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Channel}"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                  <DataTemplate DataType="vm:BuildTargetChoice" x:DataType="vm:BuildTargetChoice">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Version}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="tag" Classes.nightly="{Binding IsNightly}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Channel}"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                  <DataTemplate DataType="vm:ManageChoice" x:DataType="vm:ManageChoice">
                    <StackPanel Classes="manage" Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <c:Icon Kind="{Binding Icon}" Width="13" Height="13" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.DataTemplates>
              </ComboBox>
              <ComboBox Classes="picker" ItemsSource="{Binding BuildChoices}" SelectedItem="{Binding BuildChoice}" AutomationProperties.Name="{c:T 'Version'}"
                        IsVisible="{Binding NoBuilds}">
                <ComboBox.DataTemplates>
                  <DataTemplate DataType="vm:BuildItemViewModel" x:DataType="vm:BuildItemViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Classes="wrap" Text="{Binding Version}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="tag" Classes.nightly="{Binding IsNightly}" Classes.pr="{Binding IsPullRequest}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Channel}"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                  <DataTemplate DataType="vm:BuildTargetChoice" x:DataType="vm:BuildTargetChoice">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Version}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="tag" Classes.nightly="{Binding IsNightly}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Channel}"/>
                      </Border>
                    </Grid>
                  </DataTemplate>
                  <DataTemplate DataType="vm:ManageChoice" x:DataType="vm:ManageChoice">
                    <StackPanel Classes="manage" Orientation="Horizontal" Spacing="8" Margin="0,2">
                      <c:Icon Kind="{Binding Icon}" Width="13" Height="13" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.DataTemplates>
              </ComboBox>
            </Panel>
          </StackPanel>
          <!-- (a version that cannot start on a slot asks on its title screen: one quiet line in the picker's place) -->
          <TextBlock Grid.Column="1" Classes="note" Text="{c:T 'This version asks for the save on its title screen'}" TextWrapping="Wrap"
                     VerticalAlignment="Bottom" Margin="2,0,0,10" IsVisible="{Binding ShowSaveTitleNote}"/>
          <StackPanel Grid.Column="1" IsVisible="{Binding ShowSavePicker}">
            <TextBlock Classes="pickercap" Text="{c:T 'Save slot'}" ToolTip.Tip="{Binding SavesPickNote}"/>
            <ComboBox Classes="picker" ItemsSource="{Binding SaveChoices}" SelectedItem="{Binding SaveChoice}" AutomationProperties.Name="{c:T 'Save slot'}"
                      ToolTip.Tip="{Binding SavesPickNote}" IsEnabled="{Binding HasBuilds}">
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate x:DataType="vm:SaveStartChoice">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <c:Icon Kind="disk" Width="15" Height="15" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Hearts, StringFormat='{}{0} ♥'}" FontWeight="Bold" Foreground="{StaticResource Bad}"
                               IsVisible="{Binding HasHearts}" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
              <ComboBox.DataTemplates>
                <DataTemplate DataType="vm:SaveStartChoice" x:DataType="vm:SaveStartChoice">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" Margin="0,2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hearts, StringFormat='{}{0} ♥'}" FontWeight="Bold" Foreground="{StaticResource Bad}"
                               IsVisible="{Binding HasHearts}"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="faint" Text="{Binding Detail}"/>
                  </Grid>
                </DataTemplate>
                <DataTemplate DataType="vm:ManageChoice" x:DataType="vm:ManageChoice">
                  <StackPanel Classes="manage" Orientation="Horizontal" Spacing="8" Margin="0,2">
                    <c:Icon Kind="{Binding Icon}" Width="13" Height="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.DataTemplates>
            </ComboBox>
          </StackPanel>
        </Grid>

        <!-- the button, a controller's first press: Build, Build it again, or Play (and Update beside it, as big, when there is one) -->
        <StackPanel Classes="gorow" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
          <Button Classes="go bigplay" Command="{Binding BuildCommand}" IsVisible="{Binding NoBuilds}" c:Pad.First="True">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Kind="download" Width="18" Height="18" Foreground="{StaticResource GoInk}"/>
              <TextBlock Text="{c:T 'Build'}" Foreground="{StaticResource GoInk}"/>
            </StackPanel>
          </Button>
          <Button Classes="primary bigplay" Command="{Binding HeroPlayCommand}" IsVisible="{Binding HeroIsRebuild}" c:Pad.First="True">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Kind="refresh" Width="18" Height="18"/>
              <TextBlock Text="{Binding HeroGoText}" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
            </StackPanel>
          </Button>
          <Button Classes="go bigplay" Command="{Binding HeroPlayCommand}" IsVisible="{Binding HeroIsPlayOnly}" c:Pad.First="True">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Kind="play" Width="20" Height="20" Foreground="{StaticResource GoInk}"/>
              <TextBlock Text="{c:T 'Play'}" Foreground="{StaticResource GoInk}"/>
            </StackPanel>
          </Button>
          <!-- (a version built by Longshot's old builder: no Play here, the stable launcher offered in this one's place) -->
          <Button Classes="primary bigplay" Command="{Binding HeroStableCommand}" IsVisible="{Binding HeroIsOld}" c:Pad.First="True">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Kind="arrowUp" Width="18" Height="18"/>
              <TextBlock Text="{c:T 'Switch to the stable launcher'}" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
            </StackPanel>
          </Button>
          <!-- (an update for the version shown: a second button of the same size, beside Play) -->
          <Button Classes="second bigplay" Command="{Binding UpdateDefaultCommand}" IsVisible="{Binding HeroIsPlayAndUpdate}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Icon Kind="arrowUp" Width="18" Height="18"/>
              <TextBlock Text="{c:T 'Update'}"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- one line under it, only when it must be said: why the last Play failed, a version this launcher doesn't
             play, or with no version why there is nothing to build yet -->
        <Grid Classes="statusline" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HorizontalAlignment="Center" MaxWidth="600"
              IsVisible="{Binding HasStatusLine}">
          <Border Classes="boxicon" IsVisible="{Binding StatusIsWarning}">
            <c:Icon Kind="alert" Width="13" Height="13" Foreground="{StaticResource Warn}"/>
          </Border>
          <TextBlock Grid.Column="1" Classes="note" Classes.warn="{Binding StatusIsWarning}" Text="{Binding StatusLine}" TextWrapping="Wrap"
                     VerticalAlignment="Center"/>
          <Button Grid.Column="2" Classes="link smaller" Content="{c:T 'Try again'}" Command="{Binding RetryCheckCommand}" IsVisible="{Binding StatusCanRetry}"
                  VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>
    </Border>
  </DockPanel>
</UserControl>
