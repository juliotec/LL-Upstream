<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.FreeSpaceView"
             x:DataType="vm:FreeSpaceViewModel">
  <Border Classes="dialog">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{c:T 'Free up space?'}"/>
      <TextBlock Classes="sub" Text="{c:T 'This deletes what builds kept in the build files folder. Your games, saves, settings and mods stay.'}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding Measuring}">
        <c:Spinner Width="12" Height="12" VerticalAlignment="Center"/>
        <TextBlock Classes="hint" Margin="0" Text="{c:T 'Measuring the build files…'}"/>
      </StackPanel>
      <!-- each part with its size and what it was kept for (Disk.WorkGroups) -->
      <Border Margin="0,10,0,0" Padding="12,3" CornerRadius="8" Background="#26000000" BorderBrush="{StaticResource GlassLine}" BorderThickness="1"
              IsVisible="{Binding HasParts}">
        <ItemsControl ItemsSource="{Binding Parts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FreeSpaceViewModel+Part">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Classes="faint" Text="{Binding About}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Classes="tnum" Text="{Binding Size}" Foreground="{StaticResource InkSoft}" VerticalAlignment="Top"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <TextBlock Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Total}"/>
      <!-- the shader caches, unticked: each version prepares them again at its next start -->
      <StackPanel Margin="0,10,0,0" IsVisible="{Binding HasCaches}">
        <CheckBox Classes="tick" Content="{Binding CacheText}" IsChecked="{Binding ClearCaches}" IsEnabled="{Binding CanClearCaches}"/>
        <TextBlock Classes="hint" Margin="28,0,0,0" TextWrapping="Wrap" Text="{Binding CacheHint}"/>
      </StackPanel>
      <StackPanel Classes="buttons">
        <Button Content="{c:T 'Keep them'}" Command="{Binding KeepCommand}"/>
        <Button Classes="bad" Content="{c:T 'Delete'}" Command="{Binding DeleteCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
