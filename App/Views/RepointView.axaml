<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.RepointView"
             x:DataType="vm:RepointViewModel">
  <!-- a game whose .nup moved: the .nup picked where it is now pointed at in seconds (longshot-builder index), not a build -->
  <Border Classes="dialog">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{c:T 'Pointing the game at the moved game files'}"/>
      <TextBlock Classes="sub" TextWrapping="Wrap" Text="{Binding Sub}"/>
      <c:Spinner HorizontalAlignment="Left" Margin="0,14,0,0" IsVisible="{Binding Working}"/>
      <TextBlock Classes="bad" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Problem}" IsVisible="{Binding HasProblem}"/>
      <StackPanel Classes="buttons">
        <Button Content="{c:T 'Cancel'}" Command="{Binding CancelCommand}" c:Pad.Back="True"/>
        <Button Classes="primary" Content="{c:T 'Rebuild instead'}" Command="{Binding RebuildCommand}" IsVisible="{Binding HasProblem}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
