<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             x:Class="LongshotLauncher.Views.NfcDeleteView"
             x:DataType="vm:NfcDeleteViewModel">
  <Border Classes="dialog">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{Binding Title}"/>
      <TextBlock Classes="sub" Text="{Binding Sub}" TextWrapping="Wrap"/>
      <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="8" Background="#26000000" BorderBrush="{StaticResource GlassLine}" BorderThickness="1">
        <ItemsControl ItemsSource="{Binding Names}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Classes="mono ellipsis" Foreground="{StaticResource InkSoft}" Text="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <StackPanel Classes="buttons">
        <Button Content="{Binding KeepLabel}" Command="{Binding KeepCommand}"/>
        <Button Classes="bad" Content="Delete" Command="{Binding DeleteCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
