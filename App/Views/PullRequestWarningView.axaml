<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.PullRequestWarningView"
             x:DataType="vm:PullRequestWarningViewModel">
  <!-- the first warning before a pull request is built: every pull request has it; soft for one a BigBean wrote or approved -->
  <Border Classes="dialog wide">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{Binding Title}"/>
      <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="#26000000" BorderBrush="{StaticResource GlassLine}" BorderThickness="1">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding PrTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Classes="note" Text="{Binding PrMeta}"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="link" Content="{c:T 'Read it'}" Command="{Binding ReadCommand}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding Trusted}">
        <c:Icon Kind="check" Width="15" Height="15" Foreground="{StaticResource Go}" VerticalAlignment="Center"/>
        <TextBlock Classes="ok" Text="{Binding TrustText}" TextWrapping="Wrap" MaxWidth="520" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Classes="sub" Margin="0,12,0,0" TextWrapping="Wrap"
                 Text="{c:T 'A pull request is a change someone proposed for Longshot. It is not in a release yet: this launcher builds its code on your PC and runs it, and it may have bugs, crash, or be changed again soon.'}"/>
      <Border Classes="warnbox">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Classes="boxicon">
            <c:Icon Kind="disk" Width="13" Height="13" Foreground="{StaticResource Warn}"/>
          </Border>
          <TextBlock Grid.Column="1" TextWrapping="Wrap"
                     Text="{c:T 'Your saves are shared with your other versions, and a change can damage them. Export them first from Manage saves to keep a copy.'}"/>
        </Grid>
      </Border>
      <TextBlock Classes="hint" Margin="0,12,0,0" IsVisible="{Binding HasReplaces}" Text="{Binding ReplacesText}" TextWrapping="Wrap"/>
      <StackPanel Classes="buttons">
        <Button Content="{c:T 'Cancel'}" Command="{Binding CancelCommand}" c:Pad.Back="True"/>
        <Button Classes="primary" Content="{Binding GoText}" Command="{Binding GoCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
