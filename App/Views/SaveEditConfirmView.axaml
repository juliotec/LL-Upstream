<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.SaveEditConfirmView"
             x:DataType="vm:SaveEditConfirmViewModel">
  <Border Classes="dialog wide">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{Binding Title}"/>
      <TextBlock Classes="sub" Text="{Binding SlotLine}"/>
      <Border Classes="card" Padding="16,12" Margin="0,16,0,0">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding What}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Previewing}">
            <c:Spinner VerticalAlignment="Center"/>
            <TextBlock Classes="faint" Text="{Binding PreviewingText}" VerticalAlignment="Center"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Lines}" IsVisible="{Binding HasLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveLine">
                <TextBlock Classes="mono" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource InkSoft}" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="faint" Text="{Binding FilesLine}" IsVisible="{Binding HasFilesLine}" TextWrapping="Wrap"/>
          <TextBlock Classes="note" IsVisible="{Binding NothingToChange}" TextWrapping="Wrap"
                     Text="{c:T 'Nothing to change: the slot already is that way.'}"/>
        </StackPanel>
      </Border>
      <Border Classes="warnbox" IsVisible="{Binding HasProblem}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Classes="boxicon">
            <c:Icon Kind="alert" Width="13" Height="13" Foreground="{StaticResource Warn}"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"/>
            <TextBlock Classes="faint" Text="{Binding BackupMadeText}" IsVisible="{Binding HasBackupMade}" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Classes="warnbox" IsVisible="{Binding IsBusy}" Margin="0,10,0,0">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <Border Classes="boxicon">
            <c:Icon Kind="alert" Width="13" Height="13" Foreground="{StaticResource Warn}"/>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding CloseFirst}" TextWrapping="Wrap"/>
        </Grid>
      </Border>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,14,0,0">
        <c:Icon Kind="folder" Width="15" Height="15" Foreground="{StaticResource InkFaintText}" VerticalAlignment="Top"/>
        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource InkSoft}" Text="{Binding BackupLine}" TextWrapping="Wrap"/>
      </Grid>
      <TextBlock Classes="faint" Text="{c:T 'Close the game first: a running game writes its save again when it quits and would undo the edit.'}"
                 TextWrapping="Wrap" Margin="0,6,0,0" IsVisible="{Binding NotBusy}"/>
      <StackPanel Classes="buttons">
        <Button Content="{c:T 'Back'}" Command="{Binding BackCommand}" c:Pad.Back="True" IsVisible="{Binding HasBack}"/>
        <Button Content="{c:T 'Cancel'}" Command="{Binding CancelCommand}" c:Pad.Back="True"/>
        <Button Classes="primary" Content="{c:T 'Make the edit'}" Command="{Binding ApplyCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
