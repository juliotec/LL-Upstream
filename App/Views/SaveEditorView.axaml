<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.SaveEditorView"
             x:DataType="vm:SaveEditorViewModel">
  <UserControl.Styles>
    <Style Selector="Button.cat">
      <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style Selector="Button.cat.picked">
      <Setter Property="Background" Value="{StaticResource Selected}"/>
    </Style>
    <Style Selector="Button.cat.picked:pointerover">
      <Setter Property="Background" Value="{StaticResource Selected}"/>
    </Style>
  </UserControl.Styles>
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:SaveMissingRow">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" MinHeight="30" Margin="0,1">
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="Wrap"/>
          <TextBlock Classes="faint" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="faint tnum" Text="{Binding Count}" IsVisible="{Binding HasCount}" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="link soft smaller" Content="{c:T 'Set'}" Command="{Binding SetCommand}"/>
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid RowDefinitions="Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <Panel Classes="backslot">
        <Button Classes="back" Command="{Binding BackCommand}" c:Pad.Back="True" ToolTip.Tip="{c:T 'Back to saves'}" AutomationProperties.Name="{c:T 'Back to saves'}">
          <c:Icon Kind="arrowRight" RenderTransform="rotate(180deg)"/>
        </Button>
        <Border Classes="bglyph"><TextBlock Text="B"/></Border>
      </Panel>
      <StackPanel Margin="52,0,0,0">
        <TextBlock Classes="heading" Text="{Binding Title}"/>
        <TextBlock Classes="sub" Text="{Binding Where}" IsVisible="{Binding Showing}" Foreground="{StaticResource Ink}"/>
        <TextBlock Classes="faint" Text="{Binding Facts}" IsVisible="{Binding Showing}" Margin="0,3,0,0"/>
        <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" Foreground="{StaticResource Warn}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Classes="sub" Text="{Binding Sub}" IsVisible="{Binding NotShowing}"/>
        <StackPanel Classes="meta">
          <c:Icon Kind="check" Foreground="{StaticResource Go}"/>
          <TextBlock Text="{c:T 'Backed up first. Close the game before editing.'}"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top" HorizontalAlignment="Right">
      <!-- the slot's own actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="small" Content="{c:T 'Give…'}" Command="{Binding GiveCommand}"/>
        <Button Classes="small" Content="{c:T 'Start place…'}" Command="{Binding StartCommand}"/>
        <Button Classes="small" Content="{c:T 'Copy slot…'}" Command="{Binding CopyCommand}"/>
      </StackPanel>
      <StackPanel Spacing="6" HorizontalAlignment="Right" MinWidth="190" IsVisible="{Binding Showing}">
        <Border Classes="chip go" IsVisible="{Binding Complete}" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="check" Width="14" Height="14" Foreground="{StaticResource Go}"/>
            <TextBlock Text="{Binding Verdict}"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Verdict}" IsVisible="{Binding Incomplete}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        <c:Bar Height="6" Value="{Binding Overall}" Fill="{StaticResource Brand}" IsVisible="{Binding Incomplete}"/>
        <TextBlock Classes="faint" Text="{Binding Via}" IsVisible="{Binding HasVia}" HorizontalAlignment="Right"/>
      </StackPanel>
      </StackPanel>
    </Grid>

    <Panel Grid.Row="1">
      <StackPanel IsVisible="{Binding Loading}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <c:Spinner HorizontalAlignment="Center"/>
        <TextBlock Classes="note" Text="{Binding LoadingText}" TextAlignment="Center"/>
      </StackPanel>

      <StackPanel IsVisible="{Binding HasProblem}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Spacing="10">
        <Border Classes="warnbox">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="boxicon">
              <c:Icon Kind="alert" Width="13" Height="13" Foreground="{StaticResource Warn}"/>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Problem}" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
          <Button Content="{c:T 'Try again'}" Command="{Binding ReloadCommand}"/>
          <Button Classes="link soft" Content="{c:T 'Copy for a bug report'}" Command="{Binding ReportCommand}"/>
        </StackPanel>
      </StackPanel>

      <Grid ColumnDefinitions="300,*" ColumnSpacing="18" IsVisible="{Binding Showing}">
        <Border Classes="card">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Categories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SaveCategoryRow">
                  <Button Classes="row cat" Classes.picked="{Binding Selected}" Command="{Binding PickCommand}" c:Pad.First="True">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="faint" Text="{c:T 'not counted'}" IsVisible="{Binding NotCounted}"/>
                        <c:Icon Kind="check" Width="13" Height="13" Foreground="{StaticResource Go}" IsVisible="{Binding Done}" VerticalAlignment="Center"/>
                        <TextBlock Classes="faint tnum" Text="{Binding Count}"/>
                      </StackPanel>
                      <c:Bar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Value="{Binding Fraction}" Fill="{StaticResource Brand}" IsVisible="{Binding Open}"/>
                      <c:Bar Grid.Row="1" Grid.ColumnSpan="2" Height="4" Value="1" Fill="{StaticResource Go}" IsVisible="{Binding Done}"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Classes="card" Padding="18,14" IsVisible="{Binding HasDetail}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Classes="faint tnum" Text="{Binding DetailCount}" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="small" Content="{c:T 'Set all'}" Command="{Binding SetCategoryCommand}"/>
              <Button Grid.Column="2" Classes="small" Content="{c:T 'Take all away'}" Command="{Binding ClearCategoryCommand}"/>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="faint" Text="{Binding DetailNote}" IsVisible="{Binding HasDetailNote}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,-14,0" Padding="0,0,14,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DetailDone}" Margin="0,10">
                  <c:Icon Kind="check" Width="16" Height="16" Foreground="{StaticResource Go}" VerticalAlignment="Center"/>
                  <TextBlock Classes="note" Text="{c:T 'Nothing is missing here.'}" VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Areas}" IsVisible="{Binding HasAreas}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveAreaRow">
                      <StackPanel Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Height="30">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <c:Icon Grid.Column="1" Kind="check" Width="13" Height="13" Foreground="{StaticResource Go}" IsVisible="{Binding Done}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Classes="faint tnum" Text="{Binding Count}" IsVisible="{Binding Open}" VerticalAlignment="Center"/>
                          <Button Grid.Column="2" Classes="link soft smaller" Content="{c:T 'Set'}" Command="{Binding SetCommand}" IsVisible="{Binding Open}"/>
                          <Button Grid.Column="3" Classes="link soft smaller" Content="{c:T 'Take away'}" Command="{Binding ClearCommand}" IsVisible="{Binding HasAny}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Entries}" Margin="12,0,0,0"/>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="label" Text="{c:T 'Missing'}" Margin="0,12,0,4" IsVisible="{Binding HasMissing}"/>
                <ItemsControl ItemsSource="{Binding Missing}" IsVisible="{Binding HasMissing}"/>

                <ItemsControl ItemsSource="{Binding Unreadable}" IsVisible="{Binding HasUnreadable}" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SaveLine">
                      <TextBlock Classes="faint" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Panel>

  </Grid>
</UserControl>
