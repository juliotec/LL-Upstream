<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.NfcView"
             x:DataType="vm:NfcViewModel">
  <UserControl.Styles>
    <Style Selector="Button.transfer">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Height" Value="56"/>
    </Style>
    <Style Selector="TextBlock.transferTitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <StackPanel>
      <TextBlock Classes="heading" Text="NFC"/>
      <TextBlock Classes="sub" TextWrapping="Wrap"
                 Text="NFC tag dumps of figures you own. In the game, the Insert menu's NFC tab picks one and taps it. Files and folders can be dropped on this page too."/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,290" ColumnSpacing="24">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="YOUR NFC TAGS" Margin="0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Classes="faint" Text="{Binding Count}" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
          <StackPanel Spacing="10">
            <!-- what the last add skipped or renamed, each file by name; or why a scan saved nothing -->
            <Border Classes="warnbox" Margin="0" IsVisible="{Binding HasReport}">
              <ItemsControl ItemsSource="{Binding Report}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock Classes="hint" Margin="0" IsVisible="{Binding TooMany}" Text="{Binding TooManyText}" TextWrapping="Wrap"/>
            <Border Classes="card" Padding="16,8">
              <Panel>
                <StackPanel IsVisible="{Binding NoRows}" Spacing="6" Margin="0,18">
                  <TextBlock Text="No NFC tags yet" FontWeight="SemiBold"/>
                  <TextBlock Classes="note" TextWrapping="Wrap"
                             Text="Add the dumps of your own figures: .bin files (a raw NTAG215 dump) or .nfc files (Flipper Zero). Each keeps its file name, which is the name the game shows."/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NfcRowViewModel">
                      <Border BorderBrush="{StaticResource GlassLine}" BorderThickness="{Binding Line}" Padding="0,7">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                          <CheckBox Classes="tick" IsChecked="{Binding IsPicked}" VerticalAlignment="Center" AutomationProperties.Name="{Binding PickName}"/>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Classes="ellipsis" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" ToolTip.Tip="{Binding Name}"/>
                            <TextBlock Classes="faint mono" IsVisible="{Binding Valid}" Text="{Binding Model}" ToolTip.Tip="The figure's model ID"/>
                            <TextBlock Classes="faint bad" IsVisible="{Binding Invalid}" Text="{Binding Problem}" TextWrapping="Wrap"/>
                          </StackPanel>
                          <Border Grid.Column="2" Classes="chip small" Classes.bad="{Binding Invalid}">
                            <TextBlock Text="{Binding Format}"/>
                          </Border>
                          <Button Grid.Column="3" Classes="icon iconbad" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete" AutomationProperties.Name="Delete">
                            <c:Icon Kind="trash"/>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="ADD NFC TAGS" Margin="0,0,0,2"/>
          <Button Classes="transfer" Command="{Binding AddCommand}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="plus" Width="18" Height="18" VerticalAlignment="Center" Foreground="{StaticResource Brand}"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="Add files…"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="One .bin or .nfc file, or many at once"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="transfer" Command="{Binding ScanCommand}" IsVisible="{Binding NotScanning}"
                  ToolTip.Tip="Reads a tag you own with a Switch 2 Pro Controller plugged in over USB. The tag is never written." ToolTip.ShowOnDisabled="True">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="nfc" Width="18" Height="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="Scan a tag…"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="{Binding ScanHint}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Button>
          <!-- a scan under way: what to do, and Cancel -->
          <Border Classes="card" Height="56" Padding="14,8" IsVisible="{Binding Scanning}">
            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="10">
              <c:Spinner VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="faint" Text="{Binding ScanText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="link" Content="Cancel" Command="{Binding CancelScanCommand}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Button Classes="transfer" Command="{Binding AddFolderCommand}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="download" Width="18" Height="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="Add a folder…"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="Every .bin and .nfc file in it"/>
              </StackPanel>
            </Grid>
          </Button>
          <!-- files being found and copied in, off the window's thread -->
          <Border Classes="card" Height="56" Padding="14,8" IsVisible="{Binding Adding}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Spinner VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="faint" Text="{Binding AddingText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <TextBlock Classes="label" Text="THE NFC FOLDER" Margin="0,10,0,2"/>
          <Button Classes="transfer" Command="{Binding OpenCommand}" ToolTip.Tip="{Binding Folder}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="folder" Width="18" Height="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="Open the folder"/>
                <TextBlock Classes="faint path" FontSize="11.5" Text="{Binding FolderShown}"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="small" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" Command="{Binding DeleteCommand}"
                  ToolTip.Tip="Tick the files to delete" ToolTip.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Icon Kind="trash" Width="14" Height="14"/>
              <TextBlock Text="{Binding DeleteLabel}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <c:Icon Kind="info" Width="14" Height="14" Foreground="{StaticResource InkFaintText}" VerticalAlignment="Center"/>
        <TextBlock Classes="faint" Text="The dumps stay on this PC, in a folder every Longshot version shares." VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
