<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:core="using:LongshotLauncher.Core"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.SaveEditAskView"
             x:DataType="vm:SaveEditAskViewModel">
  <Border Classes="dialog wide">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{Binding Title}"/>
      <TextBlock Classes="sub" Text="{Binding Sub}"/>

      <StackPanel IsVisible="{Binding IsGive}" Margin="0,16,0,0">
        <TextBlock Classes="label" Text="{c:T 'WHAT TO GIVE'}" Margin="0,0,0,6"/>
        <ComboBox Classes="dd" Width="NaN" HorizontalAlignment="Stretch" ItemsSource="{Binding GiveKinds}" SelectedItem="{Binding GiveKind}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SaveChoice"><TextBlock Text="{Binding Label}"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel IsVisible="{Binding GiveItem}">
          <TextBlock Classes="label" Text="{c:T 'ITEM'}" Margin="0,14,0,6"/>
          <ComboBox Classes="dd" Width="NaN" HorizontalAlignment="Stretch" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveItemChoice">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Label}"/>
                  <TextBlock Classes="faint" Text="{Binding Category}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel IsVisible="{Binding GiveKeys}">
          <TextBlock Classes="label" Text="{c:T 'DUNGEON'}" Margin="0,14,0,6"/>
          <ComboBox Classes="dd" Width="NaN" HorizontalAlignment="Stretch" ItemsSource="{Binding Dungeons}" SelectedItem="{Binding Dungeon}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveChoice"><TextBlock Text="{Binding Label}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel IsVisible="{Binding NeedsAmount}">
          <TextBlock Classes="label" Text="{c:T 'HOW MANY'}" Margin="0,14,0,6"/>
          <TextBox Classes="path" FontFamily="{StaticResource Ui}" Text="{Binding Amount}" Width="140" HorizontalAlignment="Left"/>
          <TextBlock Classes="hint" Text="{Binding AmountHint}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsStart}" Margin="0,16,0,0">
        <TextBlock Classes="label" Text="{c:T 'PLACE'}" Margin="0,0,0,6"/>
        <ComboBox Classes="dd" Width="NaN" HorizontalAlignment="Stretch" ItemsSource="{Binding Places}" SelectedItem="{Binding SelectedPlace}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="core:SaveEditorPlace"><TextBlock Text="{Binding Name}"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel IsVisible="{Binding ShowAge}">
          <TextBlock Classes="label" Text="{c:T 'LINK\'S AGE'}" Margin="0,14,0,6"/>
          <ComboBox Classes="dd" Width="NaN" HorizontalAlignment="Stretch" ItemsSource="{Binding Ages}" SelectedItem="{Binding Age}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveChoice"><TextBlock Text="{Binding Label}"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="hint" Text="{c:T 'This area is in both ages. The editor says when the game will make Link the other age.'}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel IsVisible="{Binding IsCopy}" Margin="0,16,0,0">
        <TextBlock Classes="label" Text="{c:T 'COPY TO'}" Margin="0,0,0,6"/>
        <ComboBox Classes="dd" Width="NaN" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SaveChoice"><TextBlock Text="{Binding Label}"/></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Loading}" Margin="0,14,0,0">
        <c:Spinner VerticalAlignment="Center"/>
        <TextBlock Classes="faint" Text="{c:T 'Asking the save editor…'}" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Classes="warnbox" IsVisible="{Binding HasProblem}">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap"/>
      </Border>
      <StackPanel Classes="buttons">
        <Button Content="{c:T 'Cancel'}" Command="{Binding CancelCommand}" c:Pad.Back="True"/>
        <Button Classes="primary" Content="{c:T 'Review'}" Command="{Binding ReviewCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
