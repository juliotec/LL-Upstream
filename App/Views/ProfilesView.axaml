<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">
  <!-- The Profiles page: a card per profile (its avatar, name, saves and game at a glance; Play as, Rename, Colour, Copy,
       Delete), New in the header. Its controller's first press is the first card's first action -->
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Classes="heading" Text="{c:T 'Profiles'}"/>
        <TextBlock Classes="sub" TextWrapping="Wrap" Text="{c:T 'A profile is a player or a setup: its own saves and game settings. Every profile plays the versions on this PC.'}"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="link" Command="{Binding NewCommand}" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Kind="plus" Width="14" Height="14"/>
          <TextBlock Text="{c:T 'New profile…'}"/>
        </StackPanel>
      </Button>
    </Grid>
    <!-- New, Rename, Copy: a name, Save or Cancel -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="16,12" Margin="0,0,0,12" IsVisible="{Binding Editing}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding EditTitle}" FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBox Classes="path" FontFamily="{StaticResource Ui}" Text="{Binding Name}" AutomationProperties.Name="{Binding EditTitle}"/>
          <Button Grid.Column="1" Classes="primary" Content="{c:T 'Save'}" Command="{Binding SaveCommand}"/>
          <Button Grid.Column="2" Content="{c:T 'Cancel'}" Command="{Binding CancelCommand}" c:Pad.Back="True"/>
        </Grid>
        <TextBlock Classes="bad" FontSize="13" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <!-- Delete: asked first, its safe answer for B -->
    <Border DockPanel.Dock="Top" Classes="warnbox" IsVisible="{Binding HasDeleting}" Margin="0,0,0,12">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding DeletingTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding DeletingQuestion}" TextWrapping="Wrap" Foreground="{StaticResource InkSoft}"/>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
          <Button Classes="small" Command="{Binding KeepCommand}" Content="{c:T 'Keep it'}" c:Pad.Back="True"/>
          <Button Classes="bad small" Command="{Binding ConfirmDeleteCommand}" Content="{c:T 'Delete'}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-14,0" Padding="0,0,14,32">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="10"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileCardViewModel">
            <Border Classes="vcard" Classes.current="{Binding IsCurrent}">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                <Border Grid.RowSpan="2" Classes="avatar card" Background="{Binding Colour}" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Initial}"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                  <WrapPanel ItemSpacing="8" LineSpacing="4">
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Classes="chip small go" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center"><TextBlock Text="{c:T 'Playing'}"/></Border>
                  </WrapPanel>
                  <TextBlock Classes="faint" Text="{Binding SavesLine}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Classes="faint" Text="{Binding GameLine}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <WrapPanel ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
                    <Button Classes="small primary" Command="{Binding PickCommand}" IsVisible="{Binding IsOther}">
                      <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Kind="play" Width="12" Height="12"/><TextBlock Text="{c:T 'Play as this profile'}"/></StackPanel>
                    </Button>
                    <Button Classes="small" Command="{Binding RenameCommand}" Content="{c:T 'Rename…'}"/>
                    <Button Classes="small" Command="{Binding ColourCommand}" ToolTip.Tip="{c:T 'Its avatar\'s colour: the next one'}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="11" Height="11" Fill="{Binding Colour}" VerticalAlignment="Center"/>
                        <TextBlock Text="{c:T 'Colour'}"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="small" Command="{Binding DuplicateCommand}" Content="{c:T 'Copy…'}" ToolTip.Tip="{c:T 'A new profile with a copy of its saves and settings'}"/>
                  </WrapPanel>
                  <Button Grid.Column="1" Classes="icon iconbad" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}"
                          ToolTip.Tip="{c:T 'Delete'}" AutomationProperties.Name="{c:T 'Delete'}"><c:Icon Kind="trash"/></Button>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
