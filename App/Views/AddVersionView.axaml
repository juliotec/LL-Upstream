<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:LongshotLauncher.Controls"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             x:Class="LongshotLauncher.Views.AddVersionView"
             x:DataType="vm:AddVersionViewModel">
  <!-- The Versions page's Add version: Stable or Nightly (each channel's newest, its older versions in the list), then Advanced,
       closed until opened: main's newest commit, or a pull request (WIP ones too), built from source after a warning -->
  <Border Classes="dialog wide">
    <StackPanel>
      <TextBlock Classes="modaltitle" Text="{c:T 'Add a version'}"/>
      <TextBlock Classes="sub" Text="{c:T 'Each version you build follows its channel, and offers that channel\'s updates.'}"/>
      <ItemsControl ItemsSource="{Binding Channels}" Margin="0,16,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="8"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AddVersionViewModel+ChannelRow">
            <RadioButton Classes="chan" GroupName="addversion" IsChecked="{Binding IsPicked}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="channame" Text="{Binding Name}" VerticalAlignment="Center"/>
                    <Border Classes="tag" Classes.nightly="{Binding IsNightly}"><TextBlock Text="{Binding Tag}"/></Border>
                  </StackPanel>
                  <TextBlock Classes="chanabout" Text="{Binding About}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" FontSize="13" Text="{Binding Newest}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
              </Grid>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- the channel's versions: its newest picked; an older one goes back -->
      <StackPanel IsVisible="{Binding IsChannel}" Margin="0,12,0,0">
        <TextBlock Classes="pickercap" Text="{c:T 'Version'}"/>
        <ComboBox Classes="picker" ItemsSource="{Binding ChannelVersions}" SelectedItem="{Binding PickedVersion}" IsEnabled="{Binding HasChannelVersions}"
                  PlaceholderText="{c:T 'No version yet'}" AutomationProperties.Name="{c:T 'Version'}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:VersionChoice">
              <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                <c:Icon Kind="check" Width="14" Height="14" Foreground="{StaticResource Go}" VerticalAlignment="Center"
                        IsVisible="{Binding Installed}" ToolTip.Tip="{c:T 'Installed'}"/>
                <TextBlock Grid.Column="1" Text="{Binding Shown}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Classes="faint" Text="{Binding Note}" VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="note" Margin="2,8,0,0" Text="{Binding PickNote}" TextWrapping="Wrap"/>
        <!-- an empty channel (no stable of longshot-builder's kind yet): the one that has versions -->
        <Button Classes="link smaller" Margin="2,6,0,0" HorizontalAlignment="Left" IsVisible="{Binding ShowOther}"
                Content="{Binding OtherText}" Command="{Binding OtherCommand}"/>
      </StackPanel>

      <!-- Advanced: closed until opened -->
      <Button Classes="link smaller" Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding AdvancedCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Kind="chevronRight" Width="13" Height="13" IsVisible="{Binding AdvancedClosed}"/>
          <c:Icon Kind="chevron" Width="13" Height="13" IsVisible="{Binding AdvancedOpen}"/>
          <TextBlock Text="{c:T 'Advanced: build from source'}"/>
        </StackPanel>
      </Button>
      <StackPanel IsVisible="{Binding AdvancedOpen}" Spacing="8" Margin="0,10,0,0">
        <RadioButton Classes="chan" GroupName="addversion" IsChecked="{Binding IsMain}">
          <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="channame" Text="{c:T 'Build main'}" VerticalAlignment="Center"/>
              <Border Classes="tag pr"><TextBlock Text="main"/></Border>
            </StackPanel>
            <TextBlock Classes="chanabout" Text="{Binding MainLine}"/>
          </StackPanel>
        </RadioButton>
        <RadioButton Classes="chan" GroupName="addversion" IsChecked="{Binding IsPull}">
          <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="channame" Text="{c:T 'Build a pull request'}" VerticalAlignment="Center"/>
              <Border Classes="tag pr"><TextBlock Text="pr"/></Border>
            </StackPanel>
            <TextBlock Classes="chanabout" Text="{c:T 'A change someone proposed for Longshot, from Beanstalk\'s list of open ones'}"/>
          </StackPanel>
        </RadioButton>
        <StackPanel IsVisible="{Binding IsPull}" Spacing="6">
          <ComboBox Classes="picker" ItemsSource="{Binding Pulls}" SelectedItem="{Binding PickedPull}" IsEnabled="{Binding HasPulls}"
                    AutomationProperties.Name="{c:T 'Pull request'}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AddVersionViewModel+PullChoice">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Border Classes="chip small warn" IsVisible="{Binding IsDraft}" VerticalAlignment="Center"><TextBlock Text="WIP"/></Border>
                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Classes="faint" Text="{Binding Note}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="note" Text="{Binding PullsProblem}" IsVisible="{Binding HasPullsProblem}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- a pull request: unreviewed code that runs here with the player's rights; a WIP one may not even build -->
        <Border Classes="warnbox" IsVisible="{Binding ShowsPullWarning}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Classes="boxicon"><c:Icon Kind="alert" Width="13" Height="13" Foreground="{StaticResource Warn}"/></Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock TextWrapping="Wrap"
                         Text="{c:T 'A pull request is code nobody has released: it is built on this PC and runs with your rights. Build only one you trust.'}"/>
              <TextBlock TextWrapping="Wrap" IsVisible="{Binding DraftPicked}"
                         Text="{c:T 'This one is a work in progress (WIP): its author has not marked it ready, and it may not build or run.'}"/>
            </StackPanel>
          </Grid>
        </Border>
        <!-- main: lighter, as it is the team's own newest code -->
        <TextBlock Classes="hint" IsVisible="{Binding ShowsMainNote}" TextWrapping="Wrap"
                   Text="{c:T 'main is Longshot\'s newest code: untested, and not a release. It is built on this PC and runs with your rights.'}"/>
      </StackPanel>

      <StackPanel Classes="buttons">
        <Button Content="{c:T 'Cancel'}" Command="{Binding CancelCommand}" c:Pad.Back="True"/>
        <Button Classes="primary" Content="{Binding GoText}" Command="{Binding GoCommand}"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
