<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LongshotLauncher.ViewModels"
        xmlns:views="using:LongshotLauncher.Views"
        xmlns:c="using:LongshotLauncher.Controls"
        x:Class="LongshotLauncher.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Longshot Launcher"
        Icon="avares://LongshotLauncher/Assets/longshot.png"
        Width="1200" Height="760" MinWidth="960" MinHeight="560" CanResize="True"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- the steps pill (the 2.x Builder's StepPill) -->
    <Style Selector="Border.step">
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="4,0,14,0"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="TextElement.FontSize" Value="13"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.step.now">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="Border.step.done">
      <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Border.num">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Background" Value="{StaticResource SoftNum}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.num.now">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.num.done">
      <Setter Property="Background" Value="{StaticResource GoSoft}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Go}"/>
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Width" Value="440"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 24 60 0 #80000000"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.dialog.wide">
      <Setter Property="Width" Value="580"/>
    </Style>
    <Style Selector="TextBlock.modaltitle">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.dialog TextBlock.sub">
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="StackPanel.buttons">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Spacing" Value="10"/>
      <Setter Property="Margin" Value="0,22,0,0"/>
    </Style>
    <Style Selector="TextBlock.channame">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.chanabout">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
    </Style>
  </Window.Styles>

  <!-- (the corners are the platform's, square when the window fills the screen: MainWindow.Shape; the TV view scales what is in
       it up to the screen) -->
  <Border Name="Frame" CornerRadius="8" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" ClipToBounds="True" Background="{StaticResource Page}">
    <Panel>
    <!-- the brand's four stripes across the window's top edge -->
    <UniformGrid Classes="stripes" Height="3" VerticalAlignment="Top" ZIndex="1" IsHitTestVisible="False">
      <Border Background="{StaticResource Rust}"/>
      <Border Background="{StaticResource Orange}"/>
      <Border Background="{StaticResource Gold}"/>
      <Border Background="{StaticResource Leaf}"/>
    </UniformGrid>
    <LayoutTransformControl Name="Scaler">
    <Panel>
      <Grid RowDefinitions="64,*">
        <!-- the title bar: drag it to move the window -->
        <Grid Name="TitleBar" ColumnDefinitions="*,Auto,*" Background="Transparent">
          <StackPanel Orientation="Horizontal" Spacing="18" Margin="28,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Source="avares://LongshotLauncher/Assets/longshot.png" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <TextBlock Text="Longshot Launcher" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding LauncherVersion}" FontSize="11" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>
          <!-- the profile: the saves under the tabs are its; its menu switches, manages and makes profiles -->
          <Button Name="ProfileChip" Classes="profilechip" IsVisible="{Binding ShowsTabs}" Command="{Binding ProfileMenuCommand}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{c:T 'Who is playing: switch, manage or make profiles'}" AutomationProperties.Name="{Binding ProfileName}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Border Classes="avatar" Background="{Binding ProfileColour}">
                <TextBlock Text="{Binding ProfileInitial}"/>
              </Border>
              <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
              <c:Icon Kind="chevron" Width="12" Height="12" VerticalAlignment="Center" Foreground="{StaticResource InkSoft}"/>
            </StackPanel>
          </Button>
          </StackPanel>
          <Popup PlacementTarget="{Binding #ProfileChip}" Placement="BottomEdgeAlignedLeft" IsOpen="{Binding ProfileMenuOpen}"
                 IsLightDismissEnabled="True" VerticalOffset="6">
            <Border Classes="menu" MinWidth="240" c:Pad.Scope="True">
              <StackPanel Spacing="2">
                <ItemsControl ItemsSource="{Binding ProfileItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileCardViewModel">
                      <Button Classes="menuitem" Command="{Binding PickCommand}" Height="44">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                          <Border Classes="avatar small" Background="{Binding Colour}"><TextBlock Text="{Binding Initial}"/></Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Classes="faint" Text="{Binding SavesLine}"/>
                          </StackPanel>
                          <c:Icon Grid.Column="2" Kind="check" Foreground="{StaticResource Lime}" IsVisible="{Binding IsCurrent}"/>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Classes="divider" Margin="4,4"/>
                <Button Classes="menuitem" Command="{Binding ManageProfilesCommand}">
                  <StackPanel Classes="manage" Orientation="Horizontal" Spacing="10"><c:Icon Kind="list"/><TextBlock Text="{c:T 'Manage profiles…'}"/></StackPanel>
                </Button>
                <Button Classes="menuitem" Command="{Binding NewProfileCommand}" c:Pad.First="True">
                  <StackPanel Classes="manage" Orientation="Horizontal" Spacing="10"><c:Icon Kind="plus"/><TextBlock Text="{c:T 'New profile…'}"/></StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Popup>
          <Border Grid.Column="1" IsVisible="{Binding InWizard}" Height="40" CornerRadius="20" Padding="4" Background="#0BFFFFFF"
                  BorderBrush="{StaticResource GlassLine}" BorderThickness="1" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepItem">
                  <Border Classes="step" Classes.now="{Binding IsNow}" Classes.done="{Binding IsDone}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="num" Classes.now="{Binding IsNow}" Classes.done="{Binding IsDone}" VerticalAlignment="Center">
                        <Panel>
                          <TextBlock Text="{Binding Number}" IsVisible="{Binding !IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <c:Icon Kind="check" Width="13" Height="13" IsVisible="{Binding IsDone}"/>
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Classes="captions">
            <!-- the tabs: the pages a player moves between, the one shown lit, on those pages only (a build or a transfer keeps
                 its own way back). The keyboard and a controller reach them up from the page; Home is a controller's B there -->
            <StackPanel Name="NavBar" Orientation="Horizontal" IsVisible="{Binding ShowsTabs}">
              <Button Classes="caption gear nav" Classes.on="{Binding IsHome}" Focusable="True" Command="{Binding GoHomeCommand}" c:Pad.Back="True"
                      ToolTip.Tip="{c:T 'Home'}" AutomationProperties.Name="{c:T 'Home'}">
                <StackPanel Classes="navitem">
                  <c:Icon Kind="home"/>
                  <TextBlock Classes="navlabel" Text="{c:T 'Home'}"/>
                </StackPanel>
              </Button>
              <Button Classes="caption gear nav" Classes.on="{Binding IsSavesShown}" Focusable="True" Command="{Binding GoSavesCommand}"
                      ToolTip.Tip="{c:T 'Saves'}" AutomationProperties.Name="{c:T 'Saves'}">
                <StackPanel Classes="navitem">
                  <c:Icon Kind="disk"/>
                  <TextBlock Classes="navlabel" Text="{c:T 'Saves'}"/>
                </StackPanel>
              </Button>
              <Button Classes="caption gear nav" Classes.on="{Binding IsVersionsShown}" Focusable="True" Command="{Binding GoVersionsCommand}"
                      ToolTip.Tip="{c:T 'Versions'}" AutomationProperties.Name="{c:T 'Versions'}">
                <StackPanel Classes="navitem">
                  <c:Icon Kind="list"/>
                  <TextBlock Classes="navlabel" Text="{c:T 'Versions'}"/>
                </StackPanel>
              </Button>
              <Button Classes="caption gear nav" Classes.on="{Binding IsSettingsShown}" Focusable="True" Command="{Binding SettingsCommand}"
                      ToolTip.Tip="{c:T 'Settings'}" AutomationProperties.Name="{c:T 'Settings'}">
                <StackPanel Classes="navitem">
                  <c:Icon Kind="gear"/>
                  <TextBlock Classes="navlabel" Text="{c:T 'Settings'}"/>
                </StackPanel>
              </Button>
              <!-- (the tabs apart from the window's own buttons) -->
              <Border Width="1" Height="18" Margin="8,0" VerticalAlignment="Center" Background="{StaticResource GlassLine}"/>
            </StackPanel>
            <Button Name="MinimizeButton" Classes="caption" Command="{Binding MinimizeCommand}" ToolTip.Tip="{c:T 'Minimize'}">
              <c:Icon Kind="min"/>
            </Button>
            <Button Classes="caption close" Command="{Binding CloseCommand}" ToolTip.Tip="{c:T 'Close'}">
              <c:Icon Kind="close"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- (no margin at the foot: a page whose content scrolls runs its scroll to the window's edge, its own padding under the last
             card, so nothing is cut by an empty band; the pages that do not scroll keep 32 px there, in their templates) -->
        <TransitioningContentControl Name="Pages" Grid.Row="1" Content="{Binding Page}" Margin="64,16,64,0">
          <TransitioningContentControl.DataTemplates>
            <DataTemplate DataType="vm:HomeViewModel"><views:HomeView/></DataTemplate>
            <DataTemplate DataType="vm:ProfilesViewModel"><views:ProfilesView/></DataTemplate>
            <DataTemplate DataType="vm:WhoViewModel"><views:WhoView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:FilesStepViewModel"><views:FilesStepView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:SettingsStepViewModel"><views:SettingsStepView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:BuildStepViewModel"><views:BuildStepView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:ReadyViewModel"><views:ReadyView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:ProblemViewModel"><views:ProblemView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:ProblemPageViewModel"><views:ProblemPageView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView/></DataTemplate>
            <DataTemplate DataType="vm:StorageViewModel"><views:StorageView/></DataTemplate>
            <DataTemplate DataType="vm:VersionsViewModel"><views:VersionsView/></DataTemplate>
            <DataTemplate DataType="vm:SavesViewModel"><views:SavesView/></DataTemplate>
            <DataTemplate DataType="vm:SavesConfirmViewModel"><views:SavesConfirmView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:SavesResultViewModel"><views:SavesResultView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:SaveEditorViewModel"><views:SaveEditorView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:BackupsViewModel"><views:BackupsView Margin="0,0,0,32"/></DataTemplate>
            <DataTemplate DataType="vm:NfcViewModel"><views:NfcView/></DataTemplate>
          </TransitioningContentControl.DataTemplates>
        </TransitioningContentControl>
      </Grid>

      <!-- a dialog over the window -->
      <Border IsVisible="{Binding HasModal}" Background="#B30A0B0E">
        <ContentControl Name="Dialog" Content="{Binding Modal}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:ChannelPickerViewModel"><views:ChannelPickerView/></DataTemplate>
            <DataTemplate DataType="vm:AddVersionViewModel"><views:AddVersionView/></DataTemplate>
            <DataTemplate DataType="vm:DeleteViewModel"><views:DeleteView/></DataTemplate>
            <DataTemplate DataType="vm:BuildFilesViewModel"><views:BuildFilesView/></DataTemplate>
            <DataTemplate DataType="vm:LicenceViewModel"><views:LicenceView/></DataTemplate>
            <DataTemplate DataType="vm:StopBuildViewModel"><views:StopBuildView/></DataTemplate>
            <DataTemplate DataType="vm:SavePickViewModel"><views:SavePickView/></DataTemplate>
            <DataTemplate DataType="vm:HookshotImportViewModel"><views:HookshotImportView/></DataTemplate>
            <DataTemplate DataType="vm:StableLauncherViewModel"><views:StableLauncherView/></DataTemplate>
            <DataTemplate DataType="vm:HookshotSettingsViewModel"><views:HookshotSettingsView/></DataTemplate>
            <DataTemplate DataType="vm:ReleaseNotesViewModel"><views:ReleaseNotesView/></DataTemplate>
            <DataTemplate DataType="vm:SaveEditAskViewModel"><views:SaveEditAskView/></DataTemplate>
            <DataTemplate DataType="vm:SaveEditConfirmViewModel"><views:SaveEditConfirmView/></DataTemplate>
            <DataTemplate DataType="vm:NfcDeleteViewModel"><views:NfcDeleteView/></DataTemplate>
            <DataTemplate DataType="vm:RemoveEverythingViewModel"><views:RemoveEverythingView/></DataTemplate>
            <DataTemplate DataType="vm:PullRequestWarningViewModel"><views:PullRequestWarningView/></DataTemplate>
            <DataTemplate DataType="vm:PullRequestConfirmViewModel"><views:PullRequestConfirmView/></DataTemplate>
            <DataTemplate DataType="vm:PullRequestFindViewModel"><views:PullRequestFindView/></DataTemplate>
            <DataTemplate DataType="vm:RepointViewModel"><views:RepointView/></DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>

      <!-- a file dragged over step 1 or the NFC page -->
      <Border IsVisible="{Binding Dropping}" Margin="10" CornerRadius="14" BorderBrush="{StaticResource Brand}" BorderThickness="2"
              Background="#1F3D63E6" IsHitTestVisible="False">
        <TextBlock Text="{Binding DropText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandInk}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <Border Classes="toast" IsVisible="{Binding HasToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
              IsHitTestVisible="False">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="24" Height="24" CornerRadius="12" Background="#403D63E6">
            <c:Icon Kind="info" Width="13" Height="13" Foreground="{StaticResource InfoInk}"/>
          </Border>
          <TextBlock Text="{Binding Toast}" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Panel>
    </LayoutTransformControl>
    <!-- the window's edges and corners, to resize it by (it has no system frame): MainWindow.Grips; not while it fills the screen -->
    <Panel Name="Grips"/>
    </Panel>
  </Border>
</Window>
